{
    "name": "notion-glaze-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@notionglaze/web",
        "dev:full": "concurrently \"npm run dev\" \"npm run worker:dev\"",
        "build": "npm run build --workspaces",
        "deploy": "npm run deploy --workspace=@notionglaze/sync-worker && npm run deploy --workspace=@notionglaze/web",
        "deploy:web": "npm run deploy --workspace=@notionglaze/web",
        "worker:dev": "npm run dev --workspace=@notionglaze/sync-worker"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "dependencies": {
        "playwright": "^1.58.1"
    }
}
