---
import Layout from "./Layout.astro";
import ThemeToggle from "./components/ThemeToggle.astro";
import Toast from "./components/Toast.astro";

interface Props {
    title: string;
    tenant?: any;
}

const { title, tenant } = Astro.props;
const tenantId = (Astro.locals as any).userId || "test-user";

import { getLiveSiteUrl } from "@notionglaze/core";
import { hexToHsl } from "./lib/utils";
import "./styles/global.css";

// --- Profile Enrichment ---
const config = tenant?.config_json ? JSON.parse(tenant.config_json) : {};
const workspaceName = config.workspace_name || "Nexus";
const rawIcon = config.workspace_icon; // Could be emoji or URL
const isEmoji = rawIcon && !rawIcon.startsWith("http");

const blogUrl = getLiveSiteUrl(tenant);

// Calculate Notion Editor URL
const notionEditorUrl = tenant?.root_page_id
    ? `https://notion.so/${tenant.root_page_id.replace(/-/g, "")}`
    : tenant?.public_link_url || "#";
const hasNotionLink = !!tenant?.root_page_id || !!tenant?.public_link_url;
---

<Layout
    title={`${title} | NotionGlaze Dashboard`}
    siteConfig={config}
    isDashboard={true}
>
    <input
        type="hidden"
        id="tenant-id-data"
        value={tenantId}
        style="display: none;"
    />
    <div class="dashboard-shell">
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="logo">NG</a>
                <a href="/" class="logo logo-full">Notion<span>Glaze</span></a>
                <button
                    id="sidebar-collapse-btn"
                    class="collapse-toggle"
                    title="Toggle Sidebar"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="toggle-icon"
                        ><path d="m11 17-5-5 5-5"></path><path
                            d="m18 17-5-5 5-5"></path></svg
                    >
                </button>
            </div>
            <nav class="sidebar-nav">
                <!-- Publishing Group -->
                <div class="nav-group">
                    <span class="group-label">Publishing</span>
                    <a
                        href="/dashboard"
                        class={`nav-item ${Astro.url.pathname === "/dashboard" || Astro.url.pathname === "/dashboard/" ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect width="7" height="9" x="3" y="3" rx="1"
                                ></rect><rect
                                    width="7"
                                    height="5"
                                    x="14"
                                    y="3"
                                    rx="1"></rect><rect
                                    width="7"
                                    height="9"
                                    x="14"
                                    y="12"
                                    rx="1"></rect><rect
                                    width="7"
                                    height="5"
                                    x="3"
                                    y="16"
                                    rx="1"></rect></svg
                            >
                        </span>
                        <span class="label">Overview</span>
                    </a>
                    <a
                        href="/dashboard/posts"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/posts") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
                                ></path><polyline
                                    points="14.5 2 14.5 7.5 20 7.5"
                                ></polyline><line x1="16" y1="13" x2="8" y2="13"
                                ></line><line x1="16" y1="17" x2="8" y2="17"
                                ></line><line x1="10" y1="9" x2="8" y2="9"
                                ></line></svg
                            >
                        </span>
                        <span class="label">Posts</span>
                    </a>
                    <a
                        href="/dashboard/sync"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/sync") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                                ></path><path d="M3 3v5h5"></path><path
                                    d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"
                                ></path><path d="M16 16h5v5"></path></svg
                            >
                        </span>
                        <span class="label">Source & Sync</span>
                    </a>
                </div>

                <!-- Branding Group -->
                <div class="nav-group">
                    <span class="group-label">Branding</span>
                    <a
                        href="/dashboard/design"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/design") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="m12 19 7-7 3 3-7 7-3-3z"></path><path
                                    d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"
                                ></path><path d="m2 2 7.586 7.586"
                                ></path><circle cx="11" cy="11" r="2"
                                ></circle></svg
                            >
                        </span>
                        <span class="label">Design Studio</span>
                    </a>
                    <a
                        href="/dashboard/navigation"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/navigation") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    width="18"
                                    height="11"
                                    x="3"
                                    y="11"
                                    rx="2"
                                    ry="2"></rect><path
                                    d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                            >
                        </span>
                        <span class="label">Navigation</span>
                    </a>
                    <a
                        href="/dashboard/editor"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/editor") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="M12 3v19"></path><path d="M5 8h14"
                                ></path><path
                                    d="M15 21a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6Z"
                                ></path></svg
                            >
                        </span>
                        <span class="label">Studio Builder</span>
                    </a>
                </div>

                <!-- Growth & SEO Group -->
                <div class="nav-group">
                    <span class="group-label">Growth & SEO</span>
                    <a
                        href="/dashboard/seo"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/seo") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><circle cx="11" cy="11" r="8"></circle><path
                                    d="m21 21-4.3-4.3"></path></svg
                            >
                        </span>
                        <span class="label">SEO</span>
                    </a>
                    <a
                        href="/dashboard/analytics"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/analytics") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="M3 3v18h18"></path><path
                                    d="m19 9-5 5-4-4-3 3"></path></svg
                            >
                        </span>
                        <span class="label">Analytics</span>
                    </a>
                </div>

                <!-- Settings Group -->
                <div class="nav-group">
                    <span class="group-label">Settings</span>
                    <a
                        href="/dashboard/settings"
                        class={`nav-item ${Astro.url.pathname === "/dashboard/settings" || Astro.url.pathname === "/dashboard/settings/" ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.72l-.15.1a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.72l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
                                ></path><circle cx="12" cy="12" r="3"
                                ></circle></svg
                            >
                        </span>
                        <span class="label">General</span>
                    </a>
                    <a
                        href="/dashboard/domains"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/domains") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><circle cx="12" cy="12" r="10"></circle><line
                                    x1="2"
                                    y1="12"
                                    x2="22"
                                    y2="12"></line><path
                                    d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                                ></path></svg
                            >
                        </span>
                        <span class="label">Domains</span>
                    </a>
                    <a
                        href="/dashboard/billing"
                        class={`nav-item ${Astro.url.pathname.startsWith("/dashboard/billing") ? "active" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                                ></path></svg
                            >
                        </span>
                        <span class="label">Billing</span>
                    </a>
                </div>

                <div class="sidebar-action">
                    <a
                        href={notionEditorUrl}
                        target="_blank"
                        class={`btn-notion-editor ${!hasNotionLink ? "hidden" : ""}`}
                    >
                        <span class="icon">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="M12 20h9"></path><path
                                    d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"
                                ></path></svg
                            >
                        </span>
                        Launch Notion Editor
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <div class="user-profile-card">
                    <div class="profile-main">
                        <div class="profile-info">
                            <div class="avatar-wrapper">
                                {
                                    rawIcon ? (
                                        isEmoji ? (
                                            <span class="emoji-avatar">
                                                {rawIcon}
                                            </span>
                                        ) : (
                                            <img
                                                src={rawIcon}
                                                class="img-avatar"
                                                alt=""
                                            />
                                        )
                                    ) : (
                                        <div class="letter-avatar">
                                            {workspaceName.charAt(0)}
                                        </div>
                                    )
                                }
                            </div>
                            <div class="profile-details">
                                <span class="workspace-name"
                                    >{workspaceName}</span
                                >
                                <div class="plan-badge-wrapper">
                                    <span
                                        class={`plan-badge ${tenant?.plan === "pro" ? "pro" : "trial"}`}
                                    >
                                        {
                                            tenant?.plan === "pro"
                                                ? "BOOTSTRAPPER"
                                                : "TRIAL"
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                        <button
                            id="logout-trigger"
                            class="btn-icon logout-icon-btn"
                            title="Log Out"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                                ></path><polyline points="16 17 21 12 16 7"
                                ></polyline><line x1="21" y1="12" x2="9" y2="12"
                                ></line></svg
                            >
                        </button>
                    </div>
                    <div class="profile-actions">
                        <ThemeToggle />
                    </div>
                </div>
            </div>
        </aside>

        <main class="dashboard-content">
            <header class="content-header">
                <div class="header-left">
                    <h1>{title}</h1>
                    <div
                        id="sync-status-indicator"
                        class={`sync-indicator ${tenant?.sync_status === "syncing" ? "" : "hidden"}`}
                    >
                        <span class="pulse-dot"></span>
                        <span class="status-text">Synchronizing...</span>
                        <span class="progress-percent" id="header-progress-val"
                            >{tenant?.sync_progress || 0}%</span
                        >
                    </div>
                </div>
                <div class="actions">
                    {
                        !tenant ||
                        (!tenant.notion_access_token &&
                            !tenant.public_link_url) ? (
                            <a
                                href="/dashboard/select-database"
                                class="btn-primary-glow small"
                            >
                                Setup Site
                            </a>
                        ) : (
                            <button
                                id="sync-btn"
                                class={`btn-sync ${tenant.sync_status === "syncing" ? "loading" : ""}`}
                            >
                                <span class="icon">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <>
                                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                                            <path d="M21 3v5h-5" />
                                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                                            <path d="M8 16H3v5" />
                                        </>
                                    </svg>
                                </span>{" "}
                                Magic Sync
                            </button>
                        )
                    }
                    <a href={blogUrl} target="_blank" class="btn-view">
                        Live Site <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            style="margin-left: 4px;"
                            ><path
                                d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                            ></path><polyline points="15 3 21 3 21 9"
                            ></polyline><line x1="10" y1="14" x2="21" y2="3"
                            ></line></svg
                        >
                    </a>
                </div>
            </header>
            <div
                id="global-progress-bar"
                class={`global-progress-container ${tenant?.sync_status === "syncing" ? "" : "hidden"}`}
            >
                <div
                    class="progress-fill"
                    style={`width: ${tenant?.sync_progress || 0}%`}
                >
                </div>
            </div>
            {
                tenant && tenant.plan === "trial" && (
                    <div
                        class={`trial-banner ${Date.now() / 1000 > tenant.trial_ends_at ? "expired" : ""}`}
                    >
                        <div class="banner-content">
                            {Date.now() / 1000 > tenant.trial_ends_at ? (
                                <strong>Your trial has expired.</strong>
                            ) : (
                                <span>
                                    You are on a{" "}
                                    <strong>14-day launch pad</strong>.
                                    <strong>
                                        {Math.max(
                                            0,
                                            Math.ceil(
                                                (tenant.trial_ends_at -
                                                    Date.now() / 1000) /
                                                    (24 * 60 * 60),
                                            ),
                                        )}{" "}
                                        days
                                    </strong>{" "}
                                    to launch your project.
                                </span>
                            )}
                            Activate the Bootstrapper Pack to keep your site
                            live.
                        </div>
                        <a href="/dashboard/billing" class="banner-btn">
                            Activate Now
                        </a>
                    </div>
                )
            }
            <div class="content-body">
                <slot />
            </div>
        </main>

        <Toast />

        <script>
            declare global {
                interface Window {
                    showToast: (
                        message: string,
                        type?: "success" | "error" | "info",
                        duration?: number,
                    ) => void;
                }
            }

            const syncBtn = document.getElementById("sync-btn");
            const tenantIdInput = document.getElementById(
                "tenant-id-data",
            ) as HTMLInputElement;
            const tenantId = tenantIdInput?.value || "test-user";

            if (syncBtn) {
                syncBtn.addEventListener("click", async () => {
                    syncBtn.classList.add("loading");
                    syncBtn.setAttribute("disabled", "true");

                    try {
                        // Trigger the unified sync endpoint
                        const response = await fetch("/api/v1/sync", {
                            method: "POST",
                        });

                        if (response.ok) {
                            // Start polling immediately after trigger
                            startSyncPolling();
                        } else {
                            const data = await response
                                .json()
                                .catch(() => ({}));
                            window.showToast(
                                `Sync failed: ${data.error || "Unknown engine error"}`,
                                "error",
                            );
                            syncBtn.classList.remove("loading");
                            syncBtn.removeAttribute("disabled");
                        }
                    } catch (e) {
                        console.error(e);
                        window.showToast("Sync connection failed.", "error");
                        syncBtn.classList.remove("loading");
                        syncBtn.removeAttribute("disabled");
                    }
                });
            }

            // --- Real-time Sync Polling ---
            let pollInterval: any = null;

            function startSyncPolling() {
                if (pollInterval) return;

                const progressBar = document.getElementById(
                    "global-progress-bar",
                );
                const progressFill = progressBar?.querySelector(
                    ".progress-fill",
                ) as HTMLElement;
                const statusIndicator = document.getElementById(
                    "sync-status-indicator",
                );
                const progressVal = document.getElementById(
                    "header-progress-val",
                );
                const syncBtn = document.getElementById("sync-btn");

                progressBar?.classList.remove("hidden");
                statusIndicator?.classList.remove("hidden");
                syncBtn?.classList.add("loading");
                syncBtn?.setAttribute("disabled", "true");

                let lastProcessedCount = -1;
                let stalledCount = 0;

                pollInterval = setInterval(async () => {
                    try {
                        const res = await fetch("/api/v1/tenant/status");
                        if (!res.ok) return;
                        const data = await res.json();

                        if (data.sync_status === "syncing") {
                            if (progressFill)
                                progressFill.style.width = `${data.sync_progress}%`;
                            if (progressVal)
                                progressVal.textContent = `${data.sync_progress}%`;

                            // Safety: check if progress is stalled
                            if (data.sync_processed === lastProcessedCount) {
                                stalledCount++;
                            } else {
                                stalledCount = 0;
                                lastProcessedCount = data.sync_processed;
                            }

                            // If stalled for ~1 minute (24 * 2.5s)
                            if (stalledCount > 24) {
                                console.warn(
                                    "Sync seems stalled. Stopping poll.",
                                );
                                clearInterval(pollInterval);
                                pollInterval = null;
                                statusIndicator?.classList.add("hidden");
                                progressBar?.classList.add("hidden");
                                syncBtn?.classList.remove("loading");
                                syncBtn?.removeAttribute("disabled");
                            }
                        } else {
                            // Sync finished or failed
                            clearInterval(pollInterval);
                            pollInterval = null;

                            if (
                                data.sync_status === "error" ||
                                data.sync_status === "failed"
                            ) {
                                window.showToast(
                                    `Sync encountered an error: ${data.last_sync_error}`,
                                    "error",
                                );
                            }

                            // Refresh page to show new content
                            window.location.reload();
                        }
                    } catch (e) {
                        console.error("Polling error:", e);
                    }
                }, 2500);
            }

            // Initialize polling if already syncing on load
            const initialStatus = document
                .getElementById("sync-status-indicator")
                ?.classList.contains("hidden")
                ? "idle"
                : "syncing";
            if (initialStatus === "syncing") {
                startSyncPolling();
            }

            // --- Sidebar Collapse Logic ---
            const sidebar = document.querySelector(".sidebar");
            const collapseBtn = document.getElementById("sidebar-collapse-btn");
            const isCollapsed =
                localStorage.getItem("sidebar-collapsed") === "true";

            if (isCollapsed && sidebar) {
                sidebar.classList.add("collapsed");
            }

            collapseBtn?.addEventListener("click", () => {
                sidebar?.classList.toggle("collapsed");
                localStorage.setItem(
                    "sidebar-collapsed",
                    sidebar?.classList.contains("collapsed") ? "true" : "false",
                );
            });

            // --- Logout Logic ---
            const logoutBtn = document.getElementById("logout-trigger");
            logoutBtn?.addEventListener("click", async () => {
                if (!confirm("Are you sure you want to log out?")) return;

                try {
                    const res = await fetch("/api/v1/auth/logout", {
                        method: "POST",
                    });
                    if (res.ok) {
                        window.location.href = "/?logout=success";
                    } else {
                        // Fallback: manual cookie clear and redirect if endpoint fails
                        document.cookie =
                            "session_id=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
                        document.cookie =
                            "notion_glaze_id=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
                        window.location.href = "/?logout=success";
                    }
                } catch (e) {
                    window.location.href = "/";
                }
            });

            // --- Sidebar Item Highlighting ---
            const updateSidebarActive = () => {
                const path = window.location.pathname;
                const navItems = document.querySelectorAll(".nav-item");

                navItems.forEach((item) => {
                    const href = item.getAttribute("href");
                    if (!href) return;

                    try {
                        const url = new URL(href, window.location.origin);
                        let isActive = false;

                        if (
                            url.pathname === "/dashboard" ||
                            url.pathname === "/dashboard/"
                        ) {
                            isActive =
                                path === "/dashboard" || path === "/dashboard/";
                        } else {
                            isActive = path.startsWith(url.pathname);
                        }

                        item.classList.toggle("active", isActive);
                    } catch (e) {}
                });
            };

            updateSidebarActive();
        </script>

