---
import { DashboardCard, StickyFooter } from "@notionglaze/ui";

interface Props {
    config: any;
    tenant: any;
}

const { config, tenant } = Astro.props;
---

<div class="space-y-8">
    <!-- Notion Connection -->
    <DashboardCard>
        <div class="space-y-4">
            <div>
                <h3 class="text-lg font-bold mb-1">Notion Connection</h3>
                <p class="text-sm text-muted-foreground">
                    Manage your Notion workspace connection
                </p>
            </div>
            <div class="space-y-3">
                <div class="flex justify-between items-center py-2">
                    <div>
                        <div class="font-medium">Connection Status</div>
                        <div class="text-sm text-muted-foreground">
                            {
                                tenant?.notion_access_token
                                    ? "Connected"
                                    : "Not connected"
                            }
                        </div>
                    </div>
                    {
                        tenant?.notion_access_token ? (
                            <button
                                id="reconnect-notion-btn"
                                class="px-4 py-2 rounded-lg border border-border hover:bg-accent text-sm font-medium"
                            >
                                Reconnect
                            </button>
                        ) : (
                            <a
                                href="/api/v1/gateway/notion/init?mode=connect"
                                class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-bold"
                            >
                                Connect Notion
                            </a>
                        )
                    }
                </div>
            </div>
        </div>
    </DashboardCard>

    <!-- Manual Sync Section -->
    <DashboardCard>
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold mb-1">Manual Sync</h3>
                    <p class="text-sm text-muted-foreground">
                        Trigger a sync immediately
                    </p>
                </div>
                <button
                    id="manual-sync-btn"
                    class="px-6 py-2 rounded-lg bg-primary text-primary-foreground font-bold hover:opacity-90 transition-opacity"
                >
                    Sync Now
                </button>
            </div>
            {
                tenant?.last_sync_at && (
                    <div class="text-xs text-muted-foreground">
                        Last synced:{" "}
                        {new Date(tenant.last_sync_at).toLocaleString()}
                    </div>
                )
            }
        </div>
    </DashboardCard>

    <!-- Auto Sync Schedule -->
    <DashboardCard>
        <div class="space-y-4">
            <div>
                <h3 class="text-lg font-bold mb-1">Automatic Sync Schedule</h3>
                <p class="text-sm text-muted-foreground">
                    Configure automatic sync intervals
                </p>
            </div>
            <div class="space-y-3">
                <label class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        id="enable-auto-sync"
                        checked={config.auto_sync_enabled !== false}
                        class="w-4 h-4 rounded border-border"
                    />
                    <span class="font-medium">Enable automatic sync</span>
                </label>
                <div class="ml-7 space-y-2">
                    <label class="block">
                        <span class="text-sm font-medium mb-1 block"
                            >Sync Interval</span
                        >
                        <select
                            id="sync-interval"
                            class="w-full px-3 py-2 rounded-lg border border-border bg-background"
                            disabled={config.auto_sync_enabled === false}
                        >
                            <option value="15">Every 15 minutes</option>
                            <option
                                value="30"
                                selected={config.sync_interval == 30}
                                >Every 30 minutes</option
                            >
                            <option
                                value="60"
                                selected={config.sync_interval == 60}
                                >Every hour</option
                            >
                            <option
                                value="180"
                                selected={config.sync_interval == 180}
                                >Every 3 hours</option
                            >
                            <option
                                value="360"
                                selected={config.sync_interval == 360}
                                >Every 6 hours</option
                            >
                            <option
                                value="720"
                                selected={config.sync_interval == 720}
                                >Every 12 hours</option
                            >
                            <option
                                value="1440"
                                selected={config.sync_interval == 1440}
                                >Daily</option
                            >
                        </select>
                    </label>
                </div>
            </div>
        </div>
    </DashboardCard>

    <!-- Sync Behavior -->
    <DashboardCard>
        <div class="space-y-4">
            <div>
                <h3 class="text-lg font-bold mb-1">Sync Behavior</h3>
                <p class="text-sm text-muted-foreground">
                    Control how content is synchronized
                </p>
            </div>
            <div class="space-y-3">
                <label class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        id="sync-published-only"
                        checked={config.sync_published_only !== false}
                        class="w-4 h-4 rounded border-border"
                    />
                    <span class="font-medium">Only sync published posts</span>
                </label>
                <label class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        id="preserve-local-edits"
                        checked={config.preserve_local_edits === true}
                        class="w-4 h-4 rounded border-border"
                    />
                    <span class="font-medium"
                        >Preserve local edits (prevent overwrite)</span
                    >
                </label>
                <label class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        id="delete-removed-posts"
                        checked={config.delete_removed_posts === true}
                        class="w-4 h-4 rounded border-border"
                    />
                    <span class="font-medium"
                        >Delete posts removed from Notion</span
                    >
                </label>
            </div>
        </div>
    </DashboardCard>

    <StickyFooter id="sync-footer" saveId="save-sync-btn" />
</div>

<script is:inline define:vars={{ initialConfig: config }}>
    (function () {
        const initSync = () => {
            // Reconnect Notion
            const reconnectBtn = document.getElementById(
                "reconnect-notion-btn",
            );
            if (reconnectBtn) {
                const newRec = reconnectBtn.cloneNode(true);
                reconnectBtn.parentNode.replaceChild(newRec, reconnectBtn);
                newRec.addEventListener("click", () => {
                    window.location.href =
                        "/api/v1/gateway/notion/init?mode=connect";
                });
            }

            // Manual sync button
            const manualSyncBtn = document.getElementById("manual-sync-btn");
            if (manualSyncBtn) {
                const newMan = manualSyncBtn.cloneNode(true);
                manualSyncBtn.parentNode.replaceChild(newMan, manualSyncBtn);
                newMan.addEventListener("click", async () => {
                    newMan.disabled = true;
                    newMan.textContent = "Syncing...";

                    try {
                        const res = await fetch("/api/v1/sync", {
                            method: "POST",
                        });
                        if (res.ok) {
                            if (window.showToast)
                                window.showToast("Sync started!", "success");
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            if (window.showToast)
                                window.showToast("Sync failed", "error");
                        }
                    } catch (e) {
                        if (window.showToast)
                            window.showToast("Connection error", "error");
                    } finally {
                        newMan.disabled = false;
                        newMan.textContent = "Sync Now";
                    }
                });
            }

            // Enable/disable interval select based on checkbox
            const enableCheckbox = document.getElementById("enable-auto-sync");
            const intervalSelect = document.getElementById("sync-interval");
            if (enableCheckbox && intervalSelect) {
                // Ensure proper clone ??
                // Just add listener, it's safe if we don't clone checkbox/select unless we have external conflicts
                enableCheckbox.addEventListener("change", (e) => {
                    intervalSelect.disabled = !e.target.checked;
                });
            }

            // Save settings
            const saveBtn = document.getElementById("save-sync-btn");
            if (saveBtn) {
                const newSave = saveBtn.cloneNode(true);
                saveBtn.parentNode.replaceChild(newSave, saveBtn);

                newSave.addEventListener("click", async () => {
                    newSave.classList.add("btn-loading");
                    newSave.disabled = true;

                    try {
                        const currentConfigRes = await fetch(
                            "/api/v1/setup/config",
                        );
                        let configToMerge = initialConfig;
                        if (currentConfigRes.ok)
                            configToMerge = await currentConfigRes.json();

                        const payload = {
                            ...configToMerge,
                            auto_sync_enabled:
                                document.getElementById("enable-auto-sync")
                                    ?.checked,
                            sync_interval: parseInt(
                                document.getElementById("sync-interval")?.value,
                            ),
                            sync_published_only: document.getElementById(
                                "sync-published-only",
                            )?.checked,
                            preserve_local_edits: document.getElementById(
                                "preserve-local-edits",
                            )?.checked,
                            delete_removed_posts: document.getElementById(
                                "delete-removed-posts",
                            )?.checked,
                        };

                        const res = await fetch("/api/v1/setup/config", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload),
                        });

                        if (res.ok) {
                            if (window.showToast)
                                window.showToast(
                                    "Sync settings updated!",
                                    "success",
                                );
                            setTimeout(() => window.location.reload(), 800);
                        } else {
                            if (window.showToast)
                                window.showToast("Save failed", "error");
                        }
                    } catch (e) {
                        if (window.showToast)
                            window.showToast("Error saving", "error");
                    } finally {
                        newSave.disabled = false;
                        newSave.classList.remove("btn-loading");
                    }
                });
            }
        };

        initSync();
        document.addEventListener("astro:page-load", initSync);
    })();
</script>
