---
import DashboardSection from "../DashboardSection.astro";
import DashboardCard from "../DashboardCard.astro";

interface Props {
    config: any;
    siteUrl: string;
}

const { config, siteUrl } = Astro.props;
---

<div class="settings-panel" id="panel-lab">
    <DashboardSection
        id="sec-seo"
        number="08"
        title="SEO Infrastructure"
        description="Machine-readable endpoints for search engine spiders."
    >
        <DashboardCard class="space-y-6">
            <div class="grid w-full gap-2">
                <label
                    class="text-[10px] font-black uppercase tracking-widest text-muted-foreground block"
                    >RSS Feed</label
                >
                <div class="flex items-center gap-3">
                    <div class="relative flex-1">
                        <input
                            type="text"
                            value={`${siteUrl}/rss.xml`}
                            readonly
                            class="flex h-11 w-full rounded-xl border border-input bg-secondary/10 px-4 py-2 text-xs font-bold text-muted-foreground/70"
                        />
                    </div>
                    <button
                        type="button"
                        class="copy-feed-btn h-11 px-5 rounded-xl border border-input bg-background text-[10px] font-black uppercase tracking-widest hover:bg-accent transition-all"
                        data-copy={`${siteUrl}/rss.xml`}
                    >
                        Copy
                    </button>
                </div>
            </div>
            <div class="grid w-full gap-2">
                <label
                    class="text-[10px] font-black uppercase tracking-widest text-muted-foreground block"
                    >Sitemap.xml</label
                >
                <div class="flex items-center gap-3">
                    <div class="relative flex-1">
                        <input
                            type="text"
                            value={`${siteUrl}/sitemap.xml`}
                            readonly
                            class="flex h-11 w-full rounded-xl border border-input bg-secondary/10 px-4 py-2 text-xs font-bold text-muted-foreground/70"
                        />
                    </div>
                    <button
                        type="button"
                        class="copy-feed-btn h-11 px-5 rounded-xl border border-input bg-background text-[10px] font-black uppercase tracking-widest hover:bg-accent transition-all"
                        data-copy={`${siteUrl}/sitemap.xml`}
                    >
                        Copy
                    </button>
                </div>
            </div>
        </DashboardCard>
    </DashboardSection>

    <DashboardSection
        id="sec-code"
        number="09"
        title="Custom DNA Injection"
        description="Hardcode styles and logic directly into your blog's head."
    >
        <DashboardCard class="space-y-8">
            <div class="grid w-full gap-3">
                <div class="flex items-center justify-between">
                    <label
                        class="text-[10px] font-black uppercase tracking-widest text-muted-foreground block"
                        >Custom CSS</label
                    >
                    <span
                        class="text-[9px] font-bold text-primary/40 uppercase tracking-tighter"
                        >Style Override</span
                    >
                </div>
                <p
                    class="text-[11px] text-muted-foreground leading-relaxed italic font-medium px-1"
                >
                    Target site elements using custom selectors. Reflected in
                    the <code>&lt;head&gt;</code> of your live site.
                </p>
                <textarea
                    id="custom-css"
                    rows="5"
                    class="flex min-h-[120px] w-full rounded-xl border border-input bg-background/50 px-4 py-3 text-[13px] font-mono shadow-sm transition-all focus:ring-1 focus:ring-primary focus:border-primary placeholder:text-muted-foreground/30 resize-y"
                    placeholder=".my-profile-link { color: #fe5d37; }"
                    >{config.custom_css || ""}</textarea
                >
            </div>

            <div class="grid w-full gap-3 pt-4 border-t border-border/30">
                <div class="flex items-center justify-between">
                    <label
                        class="text-[10px] font-black uppercase tracking-widest text-muted-foreground block"
                        >Custom Head Scripts</label
                    >
                    <span
                        class="text-[9px] font-bold text-blue-500/40 uppercase tracking-tighter"
                        >Script Injection</span
                    >
                </div>
                <p
                    class="text-[11px] text-muted-foreground leading-relaxed italic font-medium px-1"
                >
                    Inject scripts for tracking or custom functionality.
                </p>
                <textarea
                    id="custom-head-scripts"
                    rows="5"
                    class="flex min-h-[120px] w-full rounded-xl border border-input bg-background/50 px-4 py-3 text-[13px] font-mono shadow-sm transition-all focus:ring-1 focus:ring-primary focus:border-primary placeholder:text-muted-foreground/30 resize-y"
                    placeholder="<script>console.log('Hello World');</script>"
                    >{config.custom_head_scripts || ""}</textarea
                >
            </div>
        </DashboardCard>
    </DashboardSection>
</div>

<script is:inline>
    (function () {
        const notifyChange = () => {
            document.dispatchEvent(new CustomEvent("settings-change"));
        };

        const copyBtns = document.querySelectorAll(".copy-feed-btn");
        copyBtns.forEach((btn) => {
            btn.addEventListener("click", async () => {
                const text = btn.dataset.copy;
                try {
                    await navigator.clipboard.writeText(text);
                    const original = btn.textContent;
                    btn.textContent = "Copied!";
                    btn.classList.add("text-green-500", "border-green-500/50");
                    setTimeout(() => {
                        btn.textContent = original;
                        btn.classList.remove(
                            "text-green-500",
                            "border-green-500/50",
                        );
                    }, 2000);
                } catch (e) {
                    console.error("Copy failed", e);
                }
            });
        });

        document.querySelectorAll("#sec-code textarea").forEach((el) => {
            el.addEventListener("input", notifyChange);
        });
    })();
</script>
