---
interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

<div class="flex flex-col overflow-hidden rounded-3xl border border-border bg-background shadow-sm">
    {
        posts.map((post: any) => (
            <div class="group flex items-center justify-between border-b border-border p-5 last:border-0 hover:bg-secondary/30 transition-colors">
                <div class="flex flex-col gap-1">
                    <span class="font-bold group-hover:text-primary transition-colors">
                        {post.title}
                    </span>
                    <span class="text-[10px] italic text-muted-foreground">
                        /{post.slug}
                    </span>
                </div>
                <div
                    class:list={[
                        "px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider border",
                        {
                            "bg-green-100 text-green-800 border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-800": post.status.toLowerCase() === "published",
                            "bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-800": post.status.toLowerCase() === "draft",
                        }
                    ]}
                >
                    {post.status}
                </div>
            </div>
        ))
    }

    {
        posts.length === 0 && (
            <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-muted/50">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-6 w-6 text-muted-foreground"
                        aria-hidden="true"
                    >
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="8" x2="8.01" y1="13" y2="13" />
                        <line x1="8" x2="8.01" y1="17" y2="17" />
                        <line x1="12" x2="16" y1="13" y2="13" />
                        <line x1="12" x2="16" y1="17" y2="17" />
                    </svg>
                </div>
                <h3 class="text-lg font-semibold tracking-tight">No recent activity</h3>
                <p class="mt-2 text-sm text-muted-foreground max-w-[250px]">
                    Your synced posts will appear here. Start by connecting your Notion workspace.
                </p>
                <a
                    href="/dashboard/settings"
                    class="mt-6 inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
                >
                    Sync Now
                </a>
            </div>
        )
    }
</div>
