---
interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

<div class="activity-list">
    {
        posts.map((post: any) => (
            <div class="activity-item group">
                <div class="flex flex-col">
                    <span class="font-bold group-hover:text-primary transition-colors">
                        {post.title}
                    </span>
                    <span class="text-[10px] text-muted-foreground italic">
                        /{post.slug}
                    </span>
                </div>
                <div class:list={[
                    "px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider border border-transparent",
                    post.status.toLowerCase() === 'published' && "bg-green-100 text-green-800 border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-800/50",
                    post.status.toLowerCase() === 'draft' && "bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-800/50"
                ]}>
                    {post.status}
                </div>
            </div>
        ))
    }
    {
        posts.length === 0 && (
            <div class="py-16 flex flex-col items-center justify-center text-center">
                <svg
                    class="w-12 h-12 mb-4 text-muted-foreground/30"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
                    />
                </svg>
                <h3 class="text-sm font-semibold text-foreground mb-1">No posts found</h3>
                <p class="text-xs text-muted-foreground max-w-[200px]">
                    Your synced Notion pages will appear here. Start by connecting your workspace.
                </p>
            </div>
        )
    }
</div>

<style>
    .activity-list {
        display: flex;
        flex-direction: column;
        border: 1px solid hsl(var(--border));
        border-radius: 1.5rem;
        overflow: hidden;
    }

    .activity-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem;
        background: hsl(var(--background));
        border-bottom: 1px solid hsl(var(--border));
        transition: background 0.2s;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item:hover {
        background: hsl(var(--secondary) / 0.3);
    }

</style>
