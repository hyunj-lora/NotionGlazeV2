---
interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

<div class="activity-list">
    {
        posts.map((post: any) => (
            <div class="activity-item group">
                <div class="flex flex-col">
                    <span class="font-bold group-hover:text-primary transition-colors">
                        {post.title}
                    </span>
                    <span class="text-[10px] text-muted-foreground italic">
                        /{post.slug}
                    </span>
                </div>
                <div class={`status-pill ${post.status.toLowerCase()}`}>
                    {post.status}
                </div>
            </div>
        ))
    }
    {
        posts.length === 0 && (
            <div class="py-16 px-6 flex flex-col items-center justify-center text-center">
                <div class="bg-muted/50 rounded-full p-4 mb-4">
                    <svg
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-muted-foreground opacity-70"
                    >
                        <path d="M9 10h.01"></path>
                        <path d="M15 10h.01"></path>
                        <path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"></path>
                    </svg>
                </div>
                <h3 class="text-sm font-bold text-foreground mb-1">No Posts Found</h3>
                <p class="text-xs text-muted-foreground mb-4 max-w-[250px]">
                    Your activity list is empty. Start by connecting your Notion!
                </p>
                <a href="/dashboard/select-database" class="inline-flex items-center justify-center px-4 py-2 text-xs font-bold rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-2 focus-visible:outline-primary">
                    Connect Notion &rarr;
                </a>
            </div>
        )
    }
</div>

<style>
    .activity-list {
        display: flex;
        flex-direction: column;
        border: 1px solid hsl(var(--border));
        border-radius: 1.5rem;
        overflow: hidden;
    }

    .activity-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem;
        background: hsl(var(--background));
        border-bottom: 1px solid hsl(var(--border));
        transition: background 0.2s;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item:hover {
        background: hsl(var(--secondary) / 0.3);
    }

    .status-pill {
        padding: 0.25rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: 1px solid transparent;
    }

    .status-pill.published {
        background: #dcfce7;
        color: #166534;
        border-color: #bbf7d0;
    }

    .status-pill.draft {
        background: #fef3c7;
        color: #92400e;
        border-color: #fde68a;
    }
</style>
