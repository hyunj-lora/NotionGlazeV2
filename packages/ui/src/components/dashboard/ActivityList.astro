---
interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

<div class="activity-list">
    {
        posts.map((post: any) => (
            <div class="activity-item group">
                <div class="flex flex-col">
                    <span class="font-bold group-hover:text-primary transition-colors">
                        {post.title}
                    </span>
                    <span class="text-[10px] text-muted-foreground italic">
                        /{post.slug}
                    </span>
                </div>
                <div class={`status-pill ${
                    post.status.toLowerCase() === 'published'
                        ? 'bg-green-100 text-green-800 border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-800/50'
                        : 'bg-amber-100 text-amber-900 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-800/50'
                }`}>
                    {post.status}
                </div>
            </div>
        ))
    }
    {
        posts.length === 0 && (
            <div class="py-16 px-6 text-center flex flex-col items-center justify-center">
                <svg
                    class="w-12 h-12 text-muted-foreground/30 mb-4"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
                    />
                </svg>
                <h3 class="text-lg font-semibold text-foreground mb-1">No posts synced yet</h3>
                <p class="text-sm text-muted-foreground">
                    Start by connecting your Notion!
                </p>
            </div>
        )
    }
</div>

<style>
    .activity-list {
        display: flex;
        flex-direction: column;
        border: 1px solid hsl(var(--border));
        border-radius: 1.5rem;
        overflow: hidden;
    }

    .activity-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem;
        background: hsl(var(--background));
        border-bottom: 1px solid hsl(var(--border));
        transition: background 0.2s;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item:hover {
        background: hsl(var(--secondary) / 0.3);
    }

    .status-pill {
        padding: 0.25rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-width: 1px;
    }
</style>
