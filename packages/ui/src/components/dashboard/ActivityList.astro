---
interface Props {
    posts: any[];
}

const { posts } = Astro.props;

const getStatusStyles = (status: string) => {
    const s = status.toLowerCase();
    if (s === 'published') {
        return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 border-green-200 dark:border-green-800';
    }
    if (s === 'draft') {
        return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400 border-yellow-200 dark:border-yellow-800';
    }
    return 'bg-muted text-muted-foreground border-border';
};
---

<div class="flex flex-col border border-border rounded-3xl overflow-hidden bg-background">
    {
        posts.map((post: any) => (
            <div class="group flex items-center justify-between p-5 bg-background border-b border-border transition-colors hover:bg-muted/30 last:border-b-0">
                <div class="flex flex-col gap-0.5">
                    <span class="font-bold text-sm group-hover:text-primary transition-colors">
                        {post.title}
                    </span>
                    <span class="text-[10px] text-muted-foreground font-mono">
                        /{post.slug}
                    </span>
                </div>
                <div
                    class={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider border ${getStatusStyles(post.status)}`}
                    aria-label={`Status: ${post.status}`}
                >
                    {post.status}
                </div>
            </div>
        ))
    }
    {
        posts.length === 0 && (
            <div class="flex flex-col items-center justify-center py-12 px-4 text-center">
                <div class="mb-4 rounded-full bg-muted/50 p-3 text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ghost"><path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/></svg>
                </div>
                <h3 class="text-sm font-medium text-foreground">No posts synced yet</h3>
                <p class="mt-1 text-xs text-muted-foreground">
                    Connect your Notion workspace to start.
                </p>
            </div>
        )
    }
</div>
