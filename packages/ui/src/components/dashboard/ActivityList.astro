---
interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

<div class="activity-list">
    {
        posts.map((post: any) => (
            <div class="activity-item group">
                <div class="flex flex-col">
                    <span class="font-bold group-hover:text-primary transition-colors">
                        {post.title}
                    </span>
                    <span class="text-[10px] text-muted-foreground italic">
                        /{post.slug}
                    </span>
                </div>
                <div class={`status-pill ${post.status.toLowerCase()}`}>
                    {post.status}
                </div>
            </div>
        ))
    }
    {
        posts.length === 0 && (
            <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
                <div class="mb-4 rounded-full bg-secondary/50 p-4">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-8 w-8 text-muted-foreground"
                        aria-hidden="true"
                    >
                        <path d="M9 13h6" />
                        <path d="M9 17h3" />
                        <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                        <path d="M21 15.004V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9l5 5" />
                    </svg>
                </div>
                <h3 class="mb-1 text-sm font-semibold text-foreground">No posts synced yet</h3>
                <p class="mb-4 text-xs text-muted-foreground max-w-sm">
                    Connect your Notion workspace to start importing your content and building your site.
                </p>
                <a
                    href="/dashboard/select-database"
                    class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-xs font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                    Connect Notion
                </a>
            </div>
        )
    }
</div>

<style>
    .activity-list {
        display: flex;
        flex-direction: column;
        border: 1px solid hsl(var(--border));
        border-radius: 1.5rem;
        overflow: hidden;
    }

    .activity-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem;
        background: hsl(var(--background));
        border-bottom: 1px solid hsl(var(--border));
        transition: background 0.2s;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item:hover {
        background: hsl(var(--secondary) / 0.3);
    }

    .status-pill {
        padding: 0.25rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: 1px solid transparent;
    }

    .status-pill.published {
        background: var(--color-green-50, #f0fdf4);
        color: var(--color-green-700, #15803d);
        border-color: var(--color-green-200, #bbf7d0);
    }

    .status-pill.draft {
        background: var(--color-yellow-50, #fefce8);
        color: var(--color-yellow-800, #854d0e);
        border-color: var(--color-yellow-200, #fef08a);
    }
</style>
