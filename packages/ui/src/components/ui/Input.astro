---
import { cn } from "../../lib/utils";

interface Props extends astroHTML.JSX.InputHTMLAttributes {
    label?: string;
    error?: string;
    helperText?: string;
    containerClass?: string;
}

const {
    id,
    label,
    error,
    helperText,
    containerClass,
    class: className,
    required,
    ...props
} = Astro.props;

if (!id) {
    throw new Error("Input component requires an 'id' prop for accessibility.");
}
---

<div class={cn("flex flex-col gap-1.5", containerClass)}>
    {
        label && (
            <label
                for={id}
                class="text-xs font-medium text-muted-foreground"
            >
                {label}{" "}
                {required && (
                    <span class="text-red-500" aria-hidden="true">
                        *
                    </span>
                )}
            </label>
        )
    }
    <input
        id={id}
        required={required}
        aria-invalid={error ? "true" : "false"}
        aria-describedby={
            error
                ? `${id}-error`
                : helperText
                  ? `${id}-desc`
                  : undefined
        }
        class={cn(
            "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50",
            error && "border-red-500 focus-visible:ring-red-500",
            className,
        )}
        {...props}
    />
    {
        helperText && !error && (
            <p id={`${id}-desc`} class="text-[10px] text-muted-foreground">
                {helperText}
            </p>
        )
    }
    {
        error && (
            <p
                id={`${id}-error`}
                class="text-[10px] text-red-500 font-medium"
            >
                {error}
            </p>
        )
    }
</div>
