---
import NotionRenderer from "../core/NotionRenderer.astro";
import Database from "../components/Database.astro";

interface Props {
    blocks: any[];
    idToSlugMap?: Record<string, string>;
}

const { blocks, idToSlugMap } = Astro.props;

const components = {
    DatabaseLink: Database,
};
---

<div class="terminal-theme">
    <div class="boot-header">[ SYSTEM BOOT SUCCESSFUL ]</div>
    <NotionRenderer
        blocks={blocks}
        idToSlugMap={idToSlugMap}
        components={components}
    />
</div>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap");

    :root {
        /* Terminal Theme Variables - Light (Solarized Light inspired) */
        --terminal-bg: #fdf6e3;
        --terminal-fg: #586e75;
        --terminal-border: #93a1a1;
        --terminal-accent: #b58900;
        --terminal-dim: #93a1a1;
        --terminal-code-bg: #eee8d5;
        --terminal-font: "Space Mono", monospace;

        /* Shared Component Overrides (Database etc) */
        --bg-primary: var(--terminal-bg);
        --fg-primary: var(--terminal-fg);
        --border-color: var(--terminal-border);
        --card-bg: var(--terminal-code-bg);
        --text-muted: var(--terminal-dim);
        --bg-hover: var(--terminal-code-bg);
        --bg-active: var(--terminal-dim);
        --th-bg: var(--terminal-code-bg);
        --btn-bg: var(--terminal-bg);
    }

    :global(.dark) {
        /* Terminal Theme Variables - Dark (Matrix/Classic) */
        --terminal-bg: #0c0c0c;
        --terminal-fg: #00ff00;
        --terminal-border: #00ff00;
        --terminal-accent: #00cc00;
        --terminal-dim: #004400;
        --terminal-code-bg: #001100;

        /* Shared Component Overrides */
        --bg-primary: var(--terminal-bg);
        --fg-primary: var(--terminal-fg);
        --border-color: var(--terminal-border);
        --card-bg: var(--terminal-code-bg);
        --text-muted: var(--terminal-dim);
        --bg-hover: var(--terminal-dim);
        --bg-active: var(--terminal-accent);
        --th-bg: var(--terminal-code-bg);
        --btn-bg: var(--terminal-code-bg);
    }

    .terminal-theme {
        max-width: 800px;
        margin: 0 auto;
        line-height: 1.6;
        font-size: 1rem;
        color: var(--terminal-fg);
        background-color: var(--terminal-bg);
        font-family: var(--terminal-font);
        padding: 4rem 2rem;
    }

    /* Shared Component Overrides */

    /* Callout */
    .terminal-theme :global(.notion-callout) {
        background: var(--terminal-code-bg) !important;
        border: 2px solid var(--terminal-border) !important;
        border-radius: 0 !important;
    }

    /* CodeBlock */
    .terminal-theme :global(.notion-code) {
        background: var(--terminal-code-bg) !important;
        border: 2px solid var(--terminal-border) !important;
        border-radius: 0 !important;
    }
    .terminal-theme :global(.notion-code-header) {
        background: var(--terminal-border) !important;
        color: var(--terminal-bg) !important;
    }
    .terminal-theme :global(.notion-code-lang) {
        color: inherit !important;
    }

    /* Quote */
    .terminal-theme :global(.notion-quote) {
        border-left: 4px solid var(--terminal-border) !important;
        background: var(--terminal-code-bg) !important;
    }

    /* Bookmark */
    .terminal-theme :global(.notion-bookmark) {
        border: 2px solid var(--terminal-border) !important;
        border-radius: 0 !important;
    }

    /* Equation */
    .terminal-theme :global(.notion-equation) {
        border: 1px dashed var(--terminal-border) !important;
        padding: 1rem !important;
    }

    /* Todo */
    .terminal-theme :global(.notion-todo-visual) {
        border-radius: 0 !important;
        border: 2px solid var(--terminal-accent) !important;
    }
    .terminal-theme :global(.notion-todo input:checked ~ .notion-todo-visual) {
        background-color: var(--terminal-accent) !important;
    }

    /* Divider */
    .terminal-theme :global(.notion-divider) {
        height: 2px !important;
        background: var(--terminal-border) !important;
        margin: 4rem 0 !important;
    }

    /* Table */
    .terminal-theme :global(.notion-table) {
        border: 2px solid var(--terminal-border) !important;
    }
    .terminal-theme :global(.notion-table td) {
        border: 1px solid var(--terminal-border) !important;
    }

    .boot-header {
        font-size: 0.8rem;
        font-weight: bold;
        color: var(--terminal-dim);
        margin-bottom: 2rem;
    }

    .terminal-theme :global(p) {
        margin-bottom: 1.5rem;
    }

    .terminal-theme :global(h1),
    .terminal-theme :global(h2),
    .terminal-theme :global(h3) {
        color: var(--terminal-fg);
        margin-top: 4rem;
        margin-bottom: 2rem;
        font-weight: 700;
    }

    .terminal-theme :global(h1) {
        font-size: 3rem;
        font-weight: 900;
        color: var(--terminal-accent);
    }
    .terminal-theme :global(h1)::before {
        content: "> ";
        color: var(--terminal-border);
    }

    .terminal-theme :global(h2) {
        font-size: 1.5rem;
    }
    .terminal-theme :global(h2)::before {
        content: "## ";
        color: var(--terminal-border);
    }

    .terminal-theme :global(h3) {
        font-size: 1.2rem;
    }
    .terminal-theme :global(h3)::before {
        content: "### ";
        color: var(--terminal-border);
    }

    .terminal-theme :global(ul),
    .terminal-theme :global(ol) {
        margin-bottom: 2rem;
        padding-left: 1.5rem;
        list-style: none;
    }

    .terminal-theme :global(li) {
        margin-bottom: 0.75rem;
    }

    .terminal-theme :global(ul li::before) {
        content: "* ";
        color: var(--terminal-accent);
    }

    .terminal-theme :global(img),
    .terminal-theme :global(video) {
        width: 100%;
        border: 2px solid var(--terminal-border);
        margin: 3rem 0;
        background: var(--terminal-code-bg);
    }

    .terminal-theme :global(figure) {
        margin: 3rem 0;
    }

    .terminal-theme :global(figcaption) {
        font-size: 0.8rem;
        color: var(--terminal-dim);
        margin-top: 1rem;
        text-align: center;
    }
    .terminal-theme :global(figcaption)::before {
        content: "stdout: ";
    }
</style>
