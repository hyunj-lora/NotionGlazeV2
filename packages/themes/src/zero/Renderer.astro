---
import NotionRenderer from "../core/NotionRenderer.astro";
import Database from "../components/Database.astro";

interface Props {
    blocks: any[];
    idToSlugMap?: Record<string, string>;
}

const { blocks, idToSlugMap } = Astro.props;

const components = {
    DatabaseLink: Database,
};
---

<div class="zero-theme">
    <NotionRenderer
        blocks={blocks}
        idToSlugMap={idToSlugMap}
        components={components}
    />
</div>

<style>
    .zero-theme {
        /* Theme Variables */
        --primary: #6366f1;
        --primary-rgb: 99, 102, 241;
        --primary-foreground: #ffffff;

        --secondary: #f1f5f9;
        --secondary-rgb: 241, 245, 249;
        --secondary-foreground: #0f172a;

        --accent: #e0e7ff;
        --accent-rgb: 224, 231, 255;
        --accent-foreground: #312e81;

        --background: #ffffff;
        --foreground: #0f172a;
        --muted: #f8fafc;
        --muted-foreground: #64748b;
        --border: #e2e8f0;
        --radius: 0.5rem;

        max-width: 100%;
        line-height: 1.8;
        font-size: 1.15rem;
        color: var(--foreground);
    }

    :global(.dark) .zero-theme {
        --primary: #818cf8;
        --primary-rgb: 129, 140, 248;
        --primary-foreground: #ffffff;

        --secondary: #1e293b;
        --secondary-rgb: 30, 41, 59;
        --secondary-foreground: #f8fafc;

        --accent: #312e81;
        --accent-rgb: 49, 46, 129;
        --accent-foreground: #e0e7ff;

        --background: #0f172a;
        --foreground: #f8fafc;
        --muted: #020617;
        --muted-foreground: #94a3b8;
        --border: #334155;
    }

    /* Shared Component Overrides */

    /* Callout */
    .zero-theme :global(.notion-callout) {
        background: var(--muted) !important;
        border: 1px solid var(--border) !important;
        border-radius: var(--radius) !important;
    }

    /* CodeBlock */
    .zero-theme :global(.notion-code) {
        border-radius: var(--radius) !important;
        border: 1px solid var(--border) !important;
    }

    /* Quote */
    .zero-theme :global(.notion-quote) {
        border-left: 4px solid var(--primary) !important;
        background: var(--muted) !important;
        color: var(--muted-foreground) !important;
        padding: 1.5rem !important;
        font-style: italic;
    }

    /* Bookmark */
    .zero-theme :global(.notion-bookmark) {
        border-radius: var(--radius) !important;
        border: 1px solid var(--border) !important;
    }

    /* Todo */
    .zero-theme :global(.notion-todo-visual) {
        border-radius: 4px !important;
        border-color: var(--primary) !important;
    }
    .zero-theme :global(.notion-todo input:checked ~ .notion-todo-visual) {
        background-color: var(--primary) !important;
    }

    /* Button */
    .zero-theme :global(.notion-button-link) {
        background: var(--primary) !important;
        color: var(--primary-foreground) !important;
        border-radius: var(--radius) !important;
        padding: 0.75rem 1.5rem !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.25) !important;
    }
    .zero-theme :global(.notion-button-link:hover) {
        transform: translateY(-2px) !important;
        box-shadow: 0 6px 16px rgba(var(--primary-rgb), 0.35) !important;
    }

    /* File/Pdf */
    .zero-theme :global(.notion-file-link),
    .zero-theme :global(.notion-pdf-link) {
        background: var(--muted) !important;
        border: 1px solid var(--border) !important;
        border-radius: var(--radius) !important;
    }

    /* Table */
    .zero-theme :global(.notion-table) {
        border: 1px solid var(--border) !important;
    }

    .zero-theme :global(p) {
        margin-bottom: 1.25rem;
    }

    .zero-theme :global(h1),
    .zero-theme :global(h2),
    .zero-theme :global(h3) {
        color: var(--foreground);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        font-family: "Outfit", sans-serif;
    }
    .zero-theme :global(h1) {
        font-size: 2.5rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.5rem;
    }
    .zero-theme :global(h2) {
        font-size: 1.8rem;
    }
    .zero-theme :global(h3) {
        font-size: 1.4rem;
    }

    .zero-theme :global(ul),
    .zero-theme :global(ol) {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
    }
    .zero-theme :global(li) {
        margin-bottom: 0.25rem;
    }

    @media (max-width: 640px) {
        .zero-theme {
            font-size: 1.05rem;
        }
        .zero-theme :global(h1) {
            font-size: 2rem;
        }
        .zero-theme :global(h2) {
            font-size: 1.5rem;
        }
        .zero-theme :global(h3) {
            font-size: 1.25rem;
        }
    }
</style>
