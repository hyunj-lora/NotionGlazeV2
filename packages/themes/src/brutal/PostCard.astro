---
interface Props {
    title: string;
    summary?: string | null;
    tags?: string[];
    publishedAt?: number | null;
    slug: string;
}

const { title, summary, tags, publishedAt, slug } = Astro.props;
const formattedDate = publishedAt
    ? new Date(publishedAt).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
      })
    : "";
---

<article class="post-card">
    <a href={`/blog/${slug}`}>
        <div class="meta">
            {formattedDate && <time>{formattedDate}</time>}
            {
                tags && tags.length > 0 && (
                    <span class="tags">{tags.join(" · ")}</span>
                )
            }
        </div>
        <h2>{title}</h2>
        {summary && <p>{summary}</p>}
        <div class="read-more">Read Entry →</div>
    </a>
</article>

<style>
    .post-card {
        margin-bottom: 3rem;
        background: #fff500; /* Yellow base */
        border: 4px solid var(--foreground);
        box-shadow: 12px 12px 0 var(--foreground);
        transition: transform 0.1s ease;
    }
    .post-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 16px 16px 0 var(--foreground);
    }
    .post-card a {
        display: block;
        padding: 2rem;
        text-decoration: none;
        color: var(--background); /* Fixed contrast for yellow background */
    }
    .meta {
        font-family: "Lexend", sans-serif;
        font-weight: 800;
        font-size: 0.8rem;
        text-transform: uppercase;
        margin-bottom: 1rem;
        background: var(--foreground);
        color: var(--background);
        display: inline-block;
        padding: 0.25rem 0.5rem;
    }
    h2 {
        font-family: "Lexend", sans-serif;
        font-size: 2.25rem;
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1rem;
    }
    p {
        font-family: "Lexend", sans-serif;
        font-size: 1.1rem;
        line-height: 1.4;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }
    .read-more {
        font-weight: 900;
        text-transform: uppercase;
        background: #ff00f2;
        padding: 0.5rem 1rem;
        border: 4px solid var(--foreground);
        display: inline-block;
        color: var(--background);
    }
</style>
