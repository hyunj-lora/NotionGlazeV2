---
import { BlogHeader } from "@notionglaze/ui";
import BlogFooter from "@notionglaze/ui/BlogFooter.astro";
import Renderer from "./Renderer.astro";
import type { SiteConfig } from "@notionglaze/core";

interface Props {
    config: SiteConfig;
    post: any;
    blocks: any[];
    idToSlugMap: Record<string, string>;
    tags: string[];
}

const { config, post, blocks, idToSlugMap, tags } = Astro.props;

const date = post.published_at
    ? new Date(post.published_at).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
      })
    : null;
---

<div class="brutal-theme-post">
    <BlogHeader config={config} />

    <main class="container">
        <header class="page-header">
            <div class="meta-badge">
                {date && <span>{date.toUpperCase()}</span>}
            </div>
            <h1 class="post-title">{post.title}</h1>
            <div class="tag-row">
                {
                    tags.map((tag: string) => (
                        <span class="tag">#{tag.toUpperCase()}</span>
                    ))
                }
            </div>
            {
                post.summary && (
                    <div class="summary-box">
                        <p>{post.summary}</p>
                    </div>
                )
            }
        </header>

        <article class="content">
            <Renderer blocks={blocks} idToSlugMap={idToSlugMap} />
        </article>

        <div class="page-footer">
            <a href="/blog" class="back-link">BACK TO INDEX</a>
        </div>
    </main>

    <BlogFooter config={config} />
</div>

<style>
    .brutal-theme-post {
        background-color: #fff;
        color: #000;
        font-family: "Space Mono", monospace;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .page-header {
        margin: 8rem 0 6rem 0;
    }

    .meta-badge {
        display: inline-block;
        background: #000;
        color: #fff;
        padding: 0.5rem 1rem;
        font-weight: 700;
        margin-bottom: 2rem;
        box-shadow: 6px 6px 0 #ff4dff;
    }

    .post-title {
        font-family: "Outfit", sans-serif;
        font-size: 5rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 2rem;
        text-transform: uppercase;
        letter-spacing: -0.04em;
    }

    .tag-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 3rem;
    }

    .tag {
        font-weight: 700;
        color: #ff4dff;
        background: #000;
        padding: 0.2rem 0.6rem;
    }

    .summary-box {
        border: 4px solid #000;
        padding: 2rem;
        background: #f0f0f0;
        box-shadow: 10px 10px 0 #000;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .content {
        padding: 4rem 0 10rem 0;
    }

    .page-footer {
        padding-bottom: 10rem;
    }

    .back-link {
        display: inline-block;
        background: #000;
        color: #fff;
        padding: 1rem 2rem;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 8px 8px 0 #ff4dff;
        transition: transform 0.1s;
    }

    .back-link:hover {
        transform: translate(-3px, -3px);
        box-shadow: 11px 11px 0 #ff4dff;
    }

    @media (max-width: 768px) {
        .post-title {
            font-size: 2.75rem;
        }
    }
</style>
