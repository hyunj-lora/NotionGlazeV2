---
import { BlogHeader } from "@notionglaze/ui";
import BlogFooter from "@notionglaze/ui/BlogFooter.astro";
import { type ThemeName, POST_CARDS } from "@notionglaze/themes";
import { type SiteConfig } from "@notionglaze/core";

interface Props {
    config: SiteConfig;
    posts: any[];
    defaultTheme: ThemeName;
}

const { config, posts, defaultTheme } = Astro.props;

const siteName = config.site_name || "Brutal";
const siteDescription = config.site_description || "RAW AND UNFILTERED.";

// Pre-load Brutal PostCard
const PostCardModule = await POST_CARDS.brutal();
const PostCard = PostCardModule.default;
---

<div class="brutal-theme-home">
    <BlogHeader config={config} />

    <main class="container">
        <header class="blog-header">
            <h1 class="brutal-title">{siteName}</h1>
            <div class="description-box">
                <p>{siteDescription}</p>
            </div>
        </header>

        <section class="post-list">
            {
                posts.map((post) => (
                    <div class="post-item">
                        <PostCard
                            title={post.title}
                            summary={post.summary}
                            tags={post.tags}
                            publishedAt={post.published_at}
                            slug={post.slug}
                        />
                    </div>
                ))
            }

            {
                posts.length === 0 && (
                    <div class="empty">
                        <p>EMPTY SPACE. FILL IT UP.</p>
                    </div>
                )
            }
        </section>
    </main>

    <BlogFooter config={config} />
</div>

<style>
    .brutal-theme-home {
        background-color: #ffde03;
        color: #000;
        min-height: 100vh;
        font-family: "Space Mono", monospace;
    }

    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 4rem 2.5rem;
    }

    .blog-header {
        margin: 6rem 0 10rem 0;
        transform: rotate(-1deg);
    }

    .brutal-title {
        font-family: "Outfit", sans-serif;
        font-size: 8rem;
        font-weight: 900;
        text-transform: uppercase;
        line-height: 0.9;
        margin-bottom: 2rem;
        background: #000;
        color: #ffde03;
        display: inline-block;
        padding: 1rem 2rem;
        box-shadow: 15px 15px 0 #000;
        letter-spacing: -0.05em;
    }

    .description-box {
        background: #fff;
        border: 4px solid #000;
        padding: 1.5rem 2rem;
        display: inline-block;
        box-shadow: 10px 10px 0 #000;
        margin-left: 2rem;
        font-weight: 700;
        font-size: 1.5rem;
    }

    .post-list {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        padding-bottom: 10rem;
    }

    .post-item {
        background: #fff;
        border: 5px solid #000;
        box-shadow: 12px 12px 0 #000;
        transition: transform 0.1s;
    }

    .post-item:hover {
        transform: translate(-4px, -4px);
        box-shadow: 16px 16px 0 #000;
    }

    .empty {
        padding: 8rem;
        text-align: center;
        border: 4px solid #000;
        background: #fff;
        font-weight: 900;
    }

    @media (max-width: 768px) {
        .brutal-title {
            font-size: 4rem;
        }
        .description-box {
            font-size: 1.1rem;
            margin-left: 0;
        }
    }
</style>
