---
interface Props {
    title: string;
    summary?: string | null;
    tags?: string[];
    publishedAt?: number | null;
    slug: string;
}

const { title, summary, tags, publishedAt, slug } = Astro.props;
const formattedDate = publishedAt
    ? new Date(publishedAt).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
      })
    : "";
---

<article class="post-card">
    <a href={`/blog/${slug}`}>
        <div class="meta">
            {formattedDate && <time>{formattedDate}</time>}
            {
                tags && tags.length > 0 && (
                    <span class="tags">{tags.join(" · ")}</span>
                )
            }
        </div>
        <h2>{title}</h2>
        {summary && <p>{summary}</p>}
        <div class="read-more">Read Entry →</div>
    </a>
</article>

<style>
    .post-card {
        margin-bottom: 2.5rem;
        transition: transform 0.3s ease;
    }
    .post-card:hover {
        transform: translateY(-5px);
    }
    .post-card a {
        display: block;
        padding: 2.5rem;
        background: var(--muted);
        border-radius: 2.5rem;
        text-decoration: none;
        color: var(--foreground);
        border: 1px solid var(--border);
    }
    .meta {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 0.8rem;
        color: var(--muted-foreground);
        margin-bottom: 1rem;
        font-weight: 600;
        letter-spacing: 0.05em;
    }
    h2 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.8rem;
        line-height: 1.3;
        margin-bottom: 0.75rem;
        font-weight: 700;
        color: var(--foreground);
    }
    p {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1rem;
        color: var(--muted-foreground);
        line-height: 1.6;
        margin-bottom: 0;
    }
</style>
