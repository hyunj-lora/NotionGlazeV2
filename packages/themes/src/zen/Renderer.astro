---
import NotionRenderer from "../core/NotionRenderer.astro";
import Database from "../components/Database.astro";

interface Props {
    blocks: any[];
    idToSlugMap?: Record<string, string>;
}

const { blocks, idToSlugMap } = Astro.props;

const components = {
    DatabaseLink: Database,
};
---

<div class="zen-theme">
    <NotionRenderer
        blocks={blocks}
        idToSlugMap={idToSlugMap}
        components={components}
    />
</div>

<style>
    :global(:root) {
        --zen-bg: #f7f3f0;
        --zen-bg-secondary: #fbfbfb;
        --zen-text-main: #52525b;
        --zen-text-muted: #a1a1aa;
        --zen-heading: #18181b;
        --zen-border: #e4e4e7;
        --zen-accent: #2d2d2d;
        --zen-code-bg: #fbfbfb;
        --zen-code-border: #f4f4f5;
    }

    :global(.dark) {
        --zen-bg: #18181b;
        --zen-bg-secondary: #27272a;
        --zen-text-main: #a1a1aa;
        --zen-text-muted: #71717a;
        --zen-heading: #f4f4f5;
        --zen-border: #3f3f46;
        --zen-accent: #e4e4e7;
        --zen-code-bg: #27272a;
        --zen-code-border: #3f3f46;
    }

    .zen-theme {
        max-width: 680px;
        margin: 0 auto;
        line-height: 1.7;
        font-size: 1rem;
        color: var(--zen-text-main);
        font-family: "Inter", sans-serif;
        padding: 6rem 2rem;

        /* Database Overrides */
        --border-color: var(--zen-border);
        --bg-hover: var(--zen-bg-secondary);
        --bg-active: var(--zen-border);
        --card-bg: var(--zen-bg-secondary);
        --th-bg: var(--zen-bg-secondary);
        --text-muted: var(--zen-text-muted);
        --btn-bg: var(--zen-bg);
    }

    /* Shared Component Overrides */
    .zen-theme :global(.notion-callout) {
        background: var(--zen-bg-secondary) !important;
        border: 1px solid var(--zen-border) !important;
        border-radius: 8px;
    }

    .zen-theme :global(.notion-callout-icon) {
        color: var(--zen-text-muted);
    }

    .zen-theme :global(.notion-callout-content) {
        color: var(--zen-text-main);
    }

    .zen-theme :global(.notion-code) {
        background: var(--zen-code-bg) !important;
        border: 1px solid var(--zen-code-border) !important;
    }

    .zen-theme :global(.notion-code-header) {
        background: var(--zen-bg-secondary) !important;
        border-bottom-color: var(--zen-code-border) !important;
    }

    .zen-theme :global(.notion-code-lang) {
        color: var(--zen-text-muted) !important;
    }

    .zen-theme :global(.notion-bookmark) {
        border: 1px solid #f4f4f5 !important;
        border-radius: 8px;
        color: #71717a !important;
        transition: background 0.2s;
    }
    :global(.dark) .zen-theme :global(.notion-bookmark) {
        border-color: #27272a !important;
        color: #71717a !important;
    }
    .zen-theme :global(.notion-bookmark:hover) {
        background: #fafafa;
    }
    :global(.dark) .zen-theme :global(.notion-bookmark:hover) {
        background: #18181b;
    }

    /* Toggle Overrides */
    .zen-theme :global(.notion-toggle) {
        margin: 1.5rem 0;
    }
    .zen-theme :global(.notion-toggle-icon) {
        color: var(--zen-text-muted);
    }
    .zen-theme :global(.notion-toggle-title) {
        color: var(--zen-text-main);
    }
    .zen-theme :global(.notion-toggle-content) {
        border-left: 1px dashed var(--zen-border);
    }

    /* Equation Overrides */
    .zen-theme :global(.notion-equation) {
        margin: 3rem 0;
        color: var(--zen-heading);
    }

    /* Quote Overrides */
    .zen-theme :global(.notion-quote) {
        border-left: 2px solid var(--zen-border) !important;
        color: var(--zen-text-muted) !important;
        font-style: italic;
    }

    /* Todo Overrides */
    .zen-theme :global(.notion-todo-visual) {
        border-radius: 50% !important;
        border-color: var(--zen-border) !important;
    }
    .zen-theme :global(.notion-todo input:checked ~ .notion-todo-visual) {
        background-color: var(--zen-border) !important;
    }

    /* Divider Overrides */
    .zen-theme :global(.notion-divider) {
        background-color: var(--zen-border) !important;
        margin: 4rem 0 !important;
    }

    /* Table Overrides */
    .zen-theme :global(.notion-table :global(tr)) {
        border-bottom: 1px solid var(--zen-border) !important;
    }
    .zen-theme :global(.notion-table :global(td)) {
        color: var(--zen-text-main) !important;
    }

    .zen-theme :global(p) {
        margin-bottom: 2rem;
    }

    .zen-theme :global(h1),
    .zen-theme :global(h2),
    .zen-theme :global(h3) {
        color: var(--zen-heading);
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        line-height: 1.25;
        font-weight: 300;
        letter-spacing: -0.02em;
    }

    .zen-theme :global(h1) {
        font-size: 2.5rem;
        margin-bottom: 3rem;
        letter-spacing: -0.04em;
    }

    .zen-theme :global(h2) {
        font-size: 1.5rem;
        font-weight: 400;
    }

    .zen-theme :global(h3) {
        font-size: 1.125rem;
        font-weight: 500;
    }

    .zen-theme :global(ul),
    .zen-theme :global(ol) {
        margin-bottom: 2rem;
        padding-left: 1.5rem;
    }

    .zen-theme :global(li) {
        margin-bottom: 0.75rem;
    }

    .zen-theme :global(ul li::marker) {
        content: "◦ ";
        color: var(--zen-text-muted);
    }

    .zen-theme :global(img),
    .zen-theme :global(video) {
        width: 100%;
        border-radius: 4px;
        margin: 3rem 0;
    }

    .zen-theme :global(figure) {
        margin: 3rem 0;
        text-align: center;
    }

    .zen-theme :global(figcaption) {
        font-size: 0.75rem;
        color: var(--zen-text-muted);
        margin-top: 0.75rem;
        font-style: italic;
    }
</style>
