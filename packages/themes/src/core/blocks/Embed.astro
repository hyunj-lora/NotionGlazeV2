---
import {
    validateEmbedUrl,
    getIframeSandbox,
    getCaption,
} from "../../shared/media-utils";

interface Props {
    content: any;
    class?: string;
}

const { content, class: className } = Astro.props;
const embedUrl = content.url;
const caption = getCaption(content);
const isValidUrl = validateEmbedUrl(embedUrl);
---

<div class={`notion-embed-wrapper ${className || ""}`}>
    {
        isValidUrl ? (
            <div class="notion-embed-container">
                <iframe
                    src={embedUrl}
                    title={caption || "Embedded content"}
                    allowfullscreen
                    sandbox={getIframeSandbox()}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="notion-embed-iframe"
                />
            </div>
        ) : (
            <div class="notion-media-error notion-embed-error">
                <div class="notion-error-content">
                    <span class="notion-error-icon">🔒</span>
                    <p>UNTRUSTED SOURCE or INVALID URL</p>
                    <a
                        href={embedUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="notion-error-link"
                    >
                        OPEN EXTERNALLY →
                    </a>
                </div>
            </div>
        )
    }
</div>

<style>
    .notion-embed-wrapper {
        margin: 3rem 0;
        width: 100%;
    }

    .notion-embed-container {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
        overflow: hidden;
    }

    .notion-embed-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }

    .notion-media-error {
        padding: 2rem;
        text-align: center;
        border: 1px solid #eee;
        border-radius: 8px;
    }

    .notion-error-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: center;
    }

    .notion-error-icon {
        font-size: 1.5rem;
    }

    .notion-error-link {
        font-size: 0.875rem;
        text-decoration: underline;
        color: inherit;
        opacity: 0.7;
    }
</style>
