---
import RichText from "../RichText.astro";

interface Props {
    content: any;
    children?: any;
    class?: string;
}

const { content, class: className } = Astro.props;
---

<details class={`notion-toggle ${className || ""}`}>
    <summary>
        <div class="notion-toggle-header">
            <span class="notion-toggle-icon">▿</span>
            <div class="notion-toggle-title">
                <RichText content={content.rich_text} />
            </div>
        </div>
    </summary>
    <div class="notion-toggle-content">
        <slot />
    </div>
</details>

<style>
    .notion-toggle {
        margin: 1rem 0;
    }

    summary {
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .notion-toggle-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .notion-toggle-icon {
        font-size: 0.875rem;
        transition: transform 0.2s;
        flex-shrink: 0;
    }

    details[open] .notion-toggle-icon {
        transform: rotate(180deg);
    }

    .notion-toggle-title {
        font-size: 1rem;
        font-weight: 500;
    }

    .notion-toggle-content {
        margin-top: 0.75rem;
        padding-left: 1.5rem;
    }
</style>
