---
import NotionRenderer from "../core/NotionRenderer.astro";
import Database from "../components/Database.astro";

interface Props {
    blocks: any[];
    idToSlugMap?: Record<string, string>;
}

const { blocks, idToSlugMap } = Astro.props;

// Component overrides for Tech theme
const components = {
    DatabaseLink: Database,
};
---

<div class="tech-theme">
    <NotionRenderer
        blocks={blocks}
        idToSlugMap={idToSlugMap}
        components={components}
    />
</div>

<style>
    /* Tech Theme Global Styles */
    .tech-theme {
        max-width: 100%;
        line-height: 1.7;
        font-size: 1.1rem;
        color: var(--foreground);
        font-family: "Inter", sans-serif;
    }

    /* Shared Component Overrides */

    /* CodeBlock */
    .tech-theme :global(.notion-code) {
        border-radius: 6px !important;
        background: #000 !important;
        border: 1px solid var(--border) !important;
    }
    :global(.dark) .tech-theme :global(.notion-code) {
        background: #000 !important;
    }

    /* Callout */
    .tech-theme :global(.notion-callout) {
        border-radius: 6px !important;
        background: hsl(var(--muted) / 0.5) !important;
        border: 1px solid var(--border) !important;
    }

    /* Bookmark */
    .tech-theme :global(.notion-bookmark) {
        border-radius: 6px !important;
        border: 1px solid var(--border) !important;
    }

    /* Quote */
    .tech-theme :global(.notion-quote) {
        border-left: 3px solid var(--primary) !important;
        background: hsl(var(--primary) / 0.05) !important;
        padding: 1.5rem !important;
    }

    /* Todo */
    .tech-theme :global(.notion-todo-visual) {
        border-radius: 2px !important;
        border-color: var(--primary) !important;
    }
    .tech-theme :global(.notion-todo input:checked ~ .notion-todo-visual) {
        background-color: var(--primary) !important;
    }

    /* Divider */
    .tech-theme :global(.notion-divider) {
        height: 1px !important;
        background: linear-gradient(
            90deg,
            var(--primary) 0%,
            transparent 100%
        ) !important;
        border: 0 !important;
    }

    .tech-theme :global(p) {
        margin-bottom: 1.5rem;
    }

    .tech-theme :global(h1),
    .tech-theme :global(h2),
    .tech-theme :global(h3) {
        color: var(--foreground);
        margin-top: 3rem;
        margin-bottom: 1rem;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .tech-theme :global(h1) {
        font-size: 2.75rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1rem;
        color: var(--primary);
    }

    .tech-theme :global(h2) {
        font-size: 2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .tech-theme :global(h2::before) {
        content: ">";
        color: var(--primary);
        font-family: monospace;
        font-size: 1.5rem;
        opacity: 0.7;
    }

    .tech-theme :global(ul),
    .tech-theme :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    .tech-theme :global(ul) {
        list-style-type: square;
    }
    .tech-theme :global(li::marker) {
        color: hsl(var(--primary));
    }
</style>
