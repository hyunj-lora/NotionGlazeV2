---
import { BlogHeader } from "@notionglaze/ui";
import BlogFooter from "@notionglaze/ui/BlogFooter.astro";
import Renderer from "./Renderer.astro";
import type { SiteConfig } from "@notionglaze/core";

interface Props {
    config: SiteConfig;
    post: any;
    blocks: any[];
    idToSlugMap: Record<string, string>;
    tags: string[];
}

const { config, post, blocks, idToSlugMap, tags } = Astro.props;

const date = post.published_at
    ? new Date(post.published_at).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
      })
    : null;
---

<div class="paper-theme-post">
    <BlogHeader config={config} />

    <main class="container">
        <header class="page-header">
            <div class="meta">
                {date && <time>{date}</time>}
            </div>
            <h1>{post.title}</h1>
            <div class="ornament">❦</div>
            {post.summary && <p class="summary">{post.summary}</p>}
        </header>

        <article class="content">
            <Renderer blocks={blocks} idToSlugMap={idToSlugMap} />
        </article>

        <div class="page-footer">
            <div class="divider"></div>
            <p>Finis.</p>
        </div>
    </main>

    <BlogFooter config={config} />
</div>

<style>
    .paper-theme-post {
        background-color: #fcfaf2;
        color: #2b2b2b;
        background-image: radial-gradient(#d6d2c1 0.5px, transparent 0.5px);
        background-size: 20px 20px;
    }

    .container {
        max-width: 750px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .page-header {
        margin: 10rem 0 8rem 0;
        text-align: center;
    }

    .meta {
        font-family: "EB Garamond", serif;
        font-size: 1.1rem;
        font-style: italic;
        color: #888;
        margin-bottom: 2rem;
    }

    h1 {
        font-family: "Playfair Display", serif;
        font-size: 4.5rem;
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .ornament {
        font-size: 2rem;
        color: #d6d2c1;
        margin-bottom: 2rem;
    }

    .summary {
        font-family: "EB Garamond", serif;
        font-size: 1.5rem;
        line-height: 1.5;
        color: #555;
        font-style: italic;
    }

    .content {
        padding-bottom: 10rem;
    }

    .page-footer {
        padding-bottom: 15rem;
        text-align: center;
        font-family: "Playfair Display", serif;
        font-style: italic;
        color: #d6d2c1;
    }

    .divider {
        height: 1px;
        background: #d6d2c1;
        width: 100px;
        margin: 0 auto 2rem auto;
    }

    @media (max-width: 640px) {
        h1 {
            font-size: 2.75rem;
        }
        .page-header {
            margin: 6rem 0 4rem 0;
        }
    }
</style>
