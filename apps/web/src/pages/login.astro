---
import Layout from "@notionglaze/ui/Layout.astro";
// Session check is handled by middleware.ts
---

<Layout title="Login to NotionGlaze">
    <div class="login-container">
        <div class="login-card">
            <div class="logo">Notion<span>Glaze</span></div>
            <h1>Get Started with Notion</h1>
            <p>Sign in seamlessly with your Notion account.</p>

            <a
                href="/api/v1/gateway/notion/init?mode=login"
                class="btn-connect"
            >
                <span class="icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"
                        ></path>
                    </svg>
                </span>
                Continue with Notion
            </a>

            <div class="meta">
                <p>No credit card required for trial.</p>
            </div>
        </div>
    </div>
</Layout>

<style>
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(
            circle at 50% 50%,
            var(--secondary) 0%,
            var(--background) 100%
        );
    }

    .login-card {
        background: var(--muted);
        border: 1px solid var(--border);
        padding: 3rem;
        border-radius: 1.5rem;
        text-align: center;
        max-width: 400px;
        width: 90%;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .logo {
        font-family: "Outfit", sans-serif;
        font-size: 1.5rem;
        font-weight: 900;
        margin-bottom: 2.5rem;
        color: var(--foreground);
    }
    .logo span {
        color: var(--primary);
    }

    h1 {
        font-size: 1.8rem;
        margin-bottom: 0.75rem;
        color: var(--foreground);
    }

    p {
        color: var(--muted-foreground);
        margin-bottom: 2rem;
        line-height: 1.5;
    }

    .btn-connect {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: var(--foreground);
        color: var(--background);
        text-decoration: none;
        padding: 1rem;
        border-radius: 0.75rem;
        font-weight: 700;
        transition:
            transform 0.2s,
            opacity 0.2s;
        font-size: 1rem;
    }
    .btn-connect:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    .icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .icon svg {
        width: 100%;
        height: 100%;
        fill: var(--background);
    }

    .meta {
        margin-top: 2rem;
        font-size: 0.75rem;
        opacity: 0.6;
    }
    .meta p {
        margin: 0;
    }
</style>
