---
import {
    DashboardLayout,
    DashboardCard,
    StickyFooter,
    NavigationEditor,
} from "@notionglaze/ui";
import { TenantService, PostService } from "@notionglaze/core";

const db = (Astro.locals as any).runtime?.env?.DB;
const tenantId = (Astro.locals as any).userId;

let tenant: any = null;
let posts: any[] = [];

if (db && tenantId) {
    try {
        const tenantService = new TenantService(db);
        tenant = await tenantService.getTenantByOwnerId(tenantId);

        if (tenant) {
            const postService = new PostService(db);
            posts = await postService.getPostsSimple(tenant.id);
        }
    } catch (e) {
        console.error("Navigation Page DB Error:", e);
    }
}

const config = tenant?.config_json ? JSON.parse(tenant.config_json) : {};
const headerConfig = config.header || {};
const footerConfig = config.footer || {};
---

<DashboardLayout title="Site Structure & Navigation" tenant={tenant}>
    <div class="max-w-4xl mx-auto pb-24 pt-8 px-4">
        <header class="mb-12">
            <h1 class="text-3xl font-black tracking-tight mb-2">
                Site Structure & Navigation
            </h1>
            <p class="text-muted-foreground">
                Manage your home page strategy, header, footer, and navigation
                links.
            </p>
        </header>

        <div class="space-y-8">
            <!-- Header Settings -->
            <DashboardCard>
                <div class="space-y-6">
                    <div>
                        <h3 class="text-lg font-bold mb-1">
                            Header Configuration
                        </h3>
                        <p class="text-sm text-muted-foreground">
                            Customize the top navigation bar.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Logo Settings -->
                        <div class="space-y-4">
                            <label class="block text-sm font-medium"
                                >Logo Type</label
                            >
                            <div class="flex gap-4">
                                <label
                                    class="flex items-center gap-2 cursor-pointer"
                                >
                                    <input
                                        type="radio"
                                        name="logo_type"
                                        value="text"
                                        checked={headerConfig.logo_type !==
                                            "image"}
                                        class="accent-primary"
                                    />
                                    <span class="text-sm">Text</span>
                                </label>
                                <label
                                    class="flex items-center gap-2 cursor-pointer"
                                >
                                    <input
                                        type="radio"
                                        name="logo_type"
                                        value="image"
                                        checked={headerConfig.logo_type ===
                                            "image"}
                                        class="accent-primary"
                                    />
                                    <span class="text-sm">Image</span>
                                </label>
                            </div>

                            <div
                                id="logo-text-group"
                                class={headerConfig.logo_type === "image"
                                    ? "hidden"
                                    : ""}
                            >
                                <label
                                    class="block text-xs text-muted-foreground mb-1"
                                    >Logo Text</label
                                >
                                <input
                                    type="text"
                                    id="logo_text"
                                    value={headerConfig.logo_text ||
                                        config.site_name ||
                                        ""}
                                    class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                                />
                            </div>

                            <div
                                id="logo-image-group"
                                class={headerConfig.logo_type !== "image"
                                    ? "hidden"
                                    : ""}
                            >
                                <label
                                    class="block text-xs text-muted-foreground mb-1"
                                    >Image URL</label
                                >
                                <input
                                    type="text"
                                    id="logo_image"
                                    value={headerConfig.logo_image || ""}
                                    placeholder="https://..."
                                    class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                                />
                            </div>
                        </div>

                        <!-- Behavior Settings -->
                        <div class="space-y-4">
                            <label class="block text-sm font-medium"
                                >Header Behavior</label
                            >
                            <select
                                id="header_behavior"
                                class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                            >
                                <option
                                    value="static"
                                    selected={headerConfig.behavior ===
                                        "static"}>Static (Scrolls away)</option
                                >
                                <option
                                    value="sticky"
                                    selected={headerConfig.behavior ===
                                        "sticky"}>Always Sticky</option
                                >
                                <option
                                    value="smart"
                                    selected={headerConfig.behavior === "smart"}
                                    >Smart (Auto-hide)</option
                                >
                            </select>
                            <p class="text-xs text-muted-foreground">
                                "Smart" hides the header when reading (scrolling
                                down) and shows it when navigating (scrolling
                                up).
                            </p>
                        </div>
                    </div>

                    <div class="border-t border-border pt-6">
                        <label class="block text-sm font-medium mb-3"
                            >Call to Action (CTA)</label
                        >
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label
                                    class="block text-xs text-muted-foreground mb-1"
                                    >Label</label
                                >
                                <input
                                    type="text"
                                    id="cta_label"
                                    value={headerConfig.cta_button?.label || ""}
                                    placeholder="e.g. Subscribe"
                                    class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                                />
                            </div>
                            <div>
                                <label
                                    class="block text-xs text-muted-foreground mb-1"
                                    >URL</label
                                >
                                <input
                                    type="text"
                                    id="cta_url"
                                    value={headerConfig.cta_button?.url || ""}
                                    placeholder="https://..."
                                    class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                                />
                            </div>
                            <div>
                                <label
                                    class="block text-xs text-muted-foreground mb-1"
                                    >Style</label
                                >
                                <select
                                    id="cta_style"
                                    class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                                >
                                    <option
                                        value="ghost"
                                        selected={headerConfig.cta_button
                                            ?.style === "ghost"}
                                        >Ghost (Subtle)</option
                                    >
                                    <option
                                        value="soft"
                                        selected={headerConfig.cta_button
                                            ?.style === "soft"}
                                        >Soft (Light Bg)</option
                                    >
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </DashboardCard>

            <!-- Navigation Editor -->
            <NavigationEditor config={config} posts={posts} />

            <!-- Footer Settings -->
            <DashboardCard>
                <div class="space-y-6">
                    <div>
                        <h3 class="text-lg font-bold mb-1">
                            Footer Configuration
                        </h3>
                        <p class="text-sm text-muted-foreground">
                            Customize the site footer.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-4">
                            <label class="block text-sm font-medium"
                                >Layout Style</label
                            >
                            <div class="grid grid-cols-2 gap-3">
                                <label class="cursor-pointer">
                                    <input
                                        type="radio"
                                        name="footer_style"
                                        value="minimal"
                                        checked={!footerConfig.style ||
                                            footerConfig.style === "minimal"}
                                        class="sr-only peer"
                                    />
                                    <div
                                        class="p-3 rounded-lg border border-border peer-checked:border-primary peer-checked:bg-primary/5 hover:bg-accent/50 transition-all text-center"
                                    >
                                        <div class="text-sm font-medium">
                                            Minimal
                                        </div>
                                        <div
                                            class="text-xs text-muted-foreground mt-1"
                                        >
                                            Simple row
                                        </div>
                                    </div>
                                </label>
                                <label class="cursor-pointer">
                                    <input
                                        type="radio"
                                        name="footer_style"
                                        value="clean-stack"
                                        checked={footerConfig.style ===
                                            "clean-stack"}
                                        class="sr-only peer"
                                    />
                                    <div
                                        class="p-3 rounded-lg border border-border peer-checked:border-primary peer-checked:bg-primary/5 hover:bg-accent/50 transition-all text-center"
                                    >
                                        <div class="text-sm font-medium">
                                            Clean Stack
                                        </div>
                                        <div
                                            class="text-xs text-muted-foreground mt-1"
                                        >
                                            Centered column
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <label class="block text-sm font-medium"
                                >Copyright Text</label
                            >
                            <input
                                type="text"
                                id="footer_copyright"
                                value={footerConfig.copyright_text ||
                                    config.footer_text ||
                                    ""}
                                placeholder="© 2024 Your Name"
                                class="w-full px-3 py-2 rounded-lg border border-border bg-background text-sm"
                            />
                            <p class="text-xs text-muted-foreground">
                                Overrides the global footer message.
                            </p>
                        </div>
                    </div>
                </div>
            </DashboardCard>
        </div>

        <StickyFooter id="nav-settings-footer" saveId="save-nav-btn" />
    </div>

    <script define:vars={{ initialConfig: config }}>
        // Toggle Logic for Logo Type
        const logoRadios = document.querySelectorAll('input[name="logo_type"]');
        const textGroup = document.getElementById("logo-text-group");
        const imageGroup = document.getElementById("logo-image-group");

        logoRadios.forEach((radio) => {
            radio.addEventListener("change", (e) => {
                if (e.target.value === "image") {
                    textGroup.classList.add("hidden");
                    imageGroup.classList.remove("hidden");
                } else {
                    textGroup.classList.remove("hidden");
                    imageGroup.classList.add("hidden");
                }
            });
        });

        // Save Logic
        const saveBtn = document.getElementById("save-nav-btn");
        if (saveBtn) {
            saveBtn.addEventListener("click", async () => {
                const btnContent = saveBtn.innerHTML;
                saveBtn.innerHTML = `<span class="animate-spin mr-2">⟳</span> Saving...`;
                saveBtn.disabled = true;

                try {
                    // Gather Header Data
                    const logoType = document.querySelector(
                        'input[name="logo_type"]:checked',
                    ).value;
                    const logoText = document.getElementById("logo_text").value;
                    const logoImage =
                        document.getElementById("logo_image").value;
                    const behavior =
                        document.getElementById("header_behavior").value;

                    const ctaLabel = document.getElementById("cta_label").value;
                    const ctaUrl = document.getElementById("cta_url").value;
                    const ctaStyle = document.getElementById("cta_style").value;

                    const headerData = {
                        logo_type: logoType,
                        logo_text: logoText,
                        logo_image: logoImage,
                        behavior: behavior,
                        cta_button: ctaLabel
                            ? { label: ctaLabel, url: ctaUrl, style: ctaStyle }
                            : null,
                    };

                    // Gather Footer Data
                    const footerStyle = document.querySelector(
                        'input[name="footer_style"]:checked',
                    ).value;
                    const footerText =
                        document.getElementById("footer_copyright").value;

                    const footerData = {
                        style: footerStyle,
                        copyright_text: footerText,
                        // preserve social_links implicitly via backend merge or we send them if we had inputs
                    };

                    const newConfig = {
                        ...initialConfig, // Preserve other settings
                        header: headerData,
                        footer: {
                            ...initialConfig.footer, // Preserve existing footer fields like social_links if they exist
                            style: footerData.style,
                            copyright_text: footerData.copyright_text,
                        },
                    };

                    const res = await fetch("/api/v1/setup/config", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            site_name: initialConfig.site_name, // Required fields often needed
                            config_json: JSON.stringify(newConfig),
                        }),
                    });

                    if (!res.ok) throw new Error("Failed to save");

                    // Show success (simple alert or toast if available)
                    // The dashboard usually has global toast handler, but let's emulate success state on button
                    saveBtn.innerHTML = `<span class="text-green-500">✓ Saved</span>`;
                    setTimeout(() => {
                        saveBtn.innerHTML = btnContent;
                        saveBtn.disabled = false;
                    }, 2000);
                } catch (e) {
                    console.error(e);
                    saveBtn.innerHTML = `<span class="text-red-500">Error</span>`;
                    setTimeout(() => {
                        saveBtn.innerHTML = btnContent;
                        saveBtn.disabled = false;
                    }, 2000);
                }
            });
        }
    </script>
</DashboardLayout>
