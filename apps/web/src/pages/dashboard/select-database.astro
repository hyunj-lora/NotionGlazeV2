---
import DashboardLayout from "@notionglaze/ui/DashboardLayout.astro";

const tenantId = (Astro.locals as any).userId;
const db = (Astro.locals as any).runtime?.env?.DB;
const encryptionSecret = (Astro.locals as any).runtime?.env?.ENCRYPTION_SECRET;

import { CryptoService } from "@notionglaze/core";

let databases: any[] = [];
let error = null;

if (!tenantId || !db) {
    return Astro.redirect("/login");
}

// Handle Database Selection POST
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const selectedId = formData.get("databaseId") as string;

        if (selectedId) {
            await db
                .prepare(
                    "UPDATE tenants SET root_page_id = ?, sync_status = 'pending' WHERE owner_id = ?",
                )
                .bind(selectedId, tenantId)
                .run();

            return Astro.redirect("/dashboard/notion-source");
        }
    } catch (e) {
        error = "Failed to save selection.";
    }
}

// Fetch Databases from Notion
try {
    const tenant = await db
        .prepare(
            "SELECT id, notion_access_token FROM tenants WHERE owner_id = ?",
        )
        .bind(tenantId)
        .first();

    if (!tenant?.notion_access_token) {
        return Astro.redirect("/dashboard/notion-source");
    }

    // Decrypt the token
    const cryptoService = new CryptoService(
        encryptionSecret || "fallback-secret-for-dev-only",
    );
    const decryptedToken = await cryptoService.decrypt(
        tenant.notion_access_token,
    );

    const response = await fetch("https://api.notion.com/v1/search", {
        method: "POST",
        headers: {
            Authorization: `Bearer ${decryptedToken}`,
            "Content-Type": "application/json",
            "Notion-Version": "2022-06-28",
        },
        body: JSON.stringify({
            filter: {
                value: "database",
                property: "object",
            },
            sort: {
                direction: "descending",
                timestamp: "last_edited_time",
            },
        }),
    });

    if (response.ok) {
        const data = await response.json();
        databases = data.results || [];
    } else {
        error = "Failed to fetch databases from Notion. Please reconnect.";
    }
} catch (e) {
    error = "Connection error. Please try again.";
}
---

<DashboardLayout title="Select Database">
    <div class="selection-container">
        <h1>Select Content Source</h1>
        <p class="subtitle">
            Choose the Notion database you want to use as your blog engine.
        </p>

        {error && <div class="error-banner">{error}</div>}

        <form method="POST" class="db-grid">
            {
                databases.map((db: any) => (
                    <label class="db-card">
                        <input
                            type="radio"
                            name="databaseId"
                            value={db.id}
                            required
                        />
                        <div class="card-content">
                            <div class="db-icon">
                                {db.icon?.type === "emoji"
                                    ? db.icon.emoji
                                    : "📄"}
                            </div>
                            <div class="db-info">
                                <h3>
                                    {db.title?.[0]?.plain_text ||
                                        "Untitled Database"}
                                </h3>
                                <div class="meta">
                                    <span>
                                        Edited{" "}
                                        {new Date(
                                            db.last_edited_time,
                                        ).toLocaleDateString()}
                                    </span>
                                </div>
                            </div>
                            <div class="check-circle" />
                        </div>
                    </label>
                ))
            }

            {
                (databases.length === 0 || error) && (
                    <div class="empty-state">
                        <p>
                            {error
                                ? "There was a problem connecting to Notion."
                                : "No databases found. Make sure you shared the correct pages with the integration."}
                        </p>
                        <a
                            href="/api/v1/gateway/notion/init"
                            class="btn-refresh"
                        >
                            {error ? "Fix Connection" : "Reconnect Notion"}
                        </a>
                    </div>
                )
            }

            <div class="actions">
                <a href="/dashboard/notion-source" class="btn-cancel">Cancel</a>
                <button
                    type="submit"
                    class="btn-submit"
                    disabled={databases.length === 0}
                >
                    Confirm Selection
                </button>
            </div>
        </form>
    </div>
</DashboardLayout>

<style>
    .selection-container {
        max-width: 800px;
        margin: 4rem auto;
        padding: 0 1.5rem;
    }
    h1 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        text-align: center;
    }
    .subtitle {
        text-align: center;
        color: var(--muted-foreground);
        margin-bottom: 3rem;
    }

    .db-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .db-card {
        cursor: pointer;
        position: relative;
    }

    .db-card input {
        position: absolute;
        opacity: 0;
    }

    .card-content {
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.2s;
    }

    .db-card:hover .card-content {
        border-color: var(--primary);
        background: rgba(var(--primary-rgb), 0.02);
    }

    .db-card input:checked + .card-content {
        border-color: var(--primary);
        background: rgba(var(--primary-rgb), 0.05);
        box-shadow: 0 0 0 2px rgba(var(--primary-rgb), 0.2);
    }

    .db-icon {
        font-size: 1.5rem;
        width: 3rem;
        height: 3rem;
        background: var(--muted);
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .db-info h3 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }
    .meta {
        font-size: 0.8rem;
        color: var(--muted-foreground);
    }

    .check-circle {
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid var(--border);
        border-radius: 50%;
        margin-left: auto;
        position: relative;
    }

    .db-card input:checked + .card-content .check-circle {
        border-color: var(--primary);
        background: var(--primary);
    }

    .db-card input:checked + .card-content .check-circle::after {
        content: "";
        position: absolute;
        top: 2px;
        left: 6px;
        width: 4px;
        height: 8px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
    }
    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-cancel {
        padding: 0.75rem 1.5rem;
        color: var(--muted-foreground);
        text-decoration: none;
        font-weight: 500;
    }

    .error-banner {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        background: var(--muted);
        border-radius: 1rem;
    }
</style>
