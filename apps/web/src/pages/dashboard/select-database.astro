---
import DashboardLayout from "@notionglaze/ui/DashboardLayout.astro";

const tenantId = (Astro.locals as any).userId;
const db = (Astro.locals as any).runtime?.env?.DB;

let error = null;

if (!tenantId || !db) {
    return Astro.redirect("/login");
}

// Handle Connection POST
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const connectionMode = formData.get("connectionMode") as string;

        if (connectionMode === "public_link") {
            const publicUrl = formData.get("publicLinkUrl") as string;
            if (publicUrl) {
                // Basic validation
                if (
                    !publicUrl.includes("notion.so") &&
                    !publicUrl.includes("notion.site")
                ) {
                    error = "Please enter a valid Notion URL.";
                } else {
                    await db
                        .prepare(
                            "UPDATE tenants SET connection_type = 'public_link', public_link_url = ?, sync_status = 'pending' WHERE owner_id = ?",
                        )
                        .bind(publicUrl, tenantId)
                        .run();
                    return Astro.redirect("/dashboard");
                }
            }
        }
    } catch (e) {
        error = "Failed to save connection. Please check your URL.";
    }
}
---

<DashboardLayout title="Setup Your Site">
    <div class="selection-container">
        <div class="header-section">
            <h1>Connect Your Content</h1>
            <p class="subtitle">
                Turn any public Notion page into a professional website in
                seconds.
            </p>
        </div>

        {error && <div class="error-banner">{error}</div>}

        <div class="connection-card">
            <div class="card-header">
                <div class="icon-circle">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                        ></path>
                        <path
                            d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                        ></path>
                    </svg>
                </div>
                <h2>Connect with Public Link</h2>
                <p>No complex permissions needed. Just share and paste.</p>
            </div>

            <form method="POST" class="connection-form">
                <input
                    type="hidden"
                    name="connectionMode"
                    value="public_link"
                />

                <div class="input-group">
                    <label for="publicLinkUrl">Notion Page URL</label>
                    <input
                        type="url"
                        id="publicLinkUrl"
                        name="publicLinkUrl"
                        placeholder="https://notion.site/your-page-id"
                        required
                        autofocus
                    />
                </div>

                <div class="instructions">
                    <h3>How to connect:</h3>
                    <ol>
                        <li>Open your page in <strong>Notion</strong></li>
                        <li>Click <strong>Share</strong> in the top right</li>
                        <li>Toggle <strong>Share to web</strong> to ON</li>
                        <li>
                            Click <strong>Copy web link</strong> and paste it above
                        </li>
                    </ol>
                </div>

                <button type="submit" class="btn-submit">
                    Build My Site
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        class="arrow"
                    >
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </form>
        </div>

        <p class="footer-note">
            Using a database? Just link the main database page. NotionGlaze
            handles the rest.
        </p>
    </div>
</DashboardLayout>

<style>
    .selection-container {
        max-width: 560px;
        margin: 6rem auto;
        padding: 0 1.5rem;
    }

    .header-section {
        text-align: center;
        margin-bottom: 3rem;
    }

    h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.75rem;
        letter-spacing: -0.02em;
    }

    .subtitle {
        color: var(--muted-foreground);
        font-size: 1.1rem;
        line-height: 1.5;
    }

    .connection-card {
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .card-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .icon-circle {
        width: 64px;
        height: 64px;
        background: rgba(var(--primary-rgb), 0.1);
        color: var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
    }

    .icon-circle svg {
        width: 32px;
        height: 32px;
    }

    .card-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .card-header p {
        color: var(--muted-foreground);
        font-size: 0.95rem;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .input-group label {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .input-group input {
        padding: 1rem;
        border-radius: 0.75rem;
        border: 2px solid var(--border);
        background: var(--background);
        font-size: 1rem;
        transition: border-color 0.2s;
    }

    .input-group input:focus {
        outline: none;
        border-color: var(--primary);
    }

    .instructions {
        background: var(--muted);
        padding: 1.5rem;
        border-radius: 1rem;
        margin-bottom: 2.5rem;
    }

    .instructions h3 {
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.7;
    }

    .instructions ol {
        margin: 0;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        font-size: 0.95rem;
        color: var(--foreground);
    }

    .instructions li strong {
        color: var(--primary);
    }

    .btn-submit {
        width: 100%;
        background: var(--foreground);
        color: var(--background);
        padding: 1.125rem;
        border-radius: 1rem;
        font-weight: 700;
        font-size: 1.1rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    .btn-submit .arrow {
        width: 20px;
        height: 20px;
        transition: transform 0.2s;
    }

    .btn-submit:hover .arrow {
        transform: translateX(4px);
    }

    .error-banner {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        padding: 1rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
        text-align: center;
        font-weight: 500;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .footer-note {
        text-align: center;
        margin-top: 2rem;
        font-size: 0.85rem;
        color: var(--muted-foreground);
        opacity: 0.7;
    }
</style>
