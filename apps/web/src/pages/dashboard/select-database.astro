---
import DashboardLayout from "@notionglaze/ui/DashboardLayout.astro";

const tenantId = (Astro.locals as any).userId;
const db = (Astro.locals as any).runtime?.env?.DB;
const encryptionSecret = (Astro.locals as any).runtime?.env?.ENCRYPTION_SECRET;

import { CryptoService } from "@notionglaze/core";

let databases: any[] = [];
let error = null;

if (!tenantId || !db) {
    return Astro.redirect("/login");
}

// Handle Database Selection POST
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const connectionMode = formData.get("connectionMode") as string;

        if (connectionMode === "public_link") {
            const publicUrl = formData.get("publicLinkUrl") as string;
            if (publicUrl) {
                await db
                    .prepare(
                        "UPDATE tenants SET connection_type = 'public_link', public_link_url = ?, sync_status = 'pending' WHERE owner_id = ?",
                    )
                    .bind(publicUrl, tenantId)
                    .run();
                return Astro.redirect("/dashboard");
            }
        } else if (connectionMode === "oauth_db") {
            const selectedId = formData.get("databaseId") as string;
            if (selectedId) {
                await db
                    .prepare(
                        "UPDATE tenants SET connection_type = 'oauth_db', root_page_id = ?, sync_status = 'pending' WHERE owner_id = ?",
                    )
                    .bind(selectedId, tenantId)
                    .run();

                return Astro.redirect("/dashboard");
            }
        }
    } catch (e) {
        error = "Failed to save selection.";
    }
}

let hasOauthConnection = false;

// Fetch Databases from Notion
try {
    const tenant = await db
        .prepare(
            "SELECT id, notion_access_token FROM tenants WHERE owner_id = ?",
        )
        .bind(tenantId)
        .first();

    if (tenant?.notion_access_token) {
        hasOauthConnection = true;
        // Decrypt the token
        const cryptoService = new CryptoService(encryptionSecret);
        const decryptedToken = await cryptoService.decrypt(
            tenant.notion_access_token,
        );

        const response = await fetch("https://api.notion.com/v1/search", {
            method: "POST",
            headers: {
                Authorization: `Bearer ${decryptedToken}`,
                "Content-Type": "application/json",
                "Notion-Version": "2022-06-28",
            },
            body: JSON.stringify({
                filter: {
                    value: "database",
                    property: "object",
                },
                sort: {
                    direction: "descending",
                    timestamp: "last_edited_time",
                },
            }),
        });

        if (response.ok) {
            const data = (await response.json()) as any;
            databases = data.results || [];
        } else {
            error =
                "Failed to fetch Notion databases. Your connection token may have expired.";
        }
    }
} catch (e) {
    error = "Connection error while checking OAuth status.";
}
---

<DashboardLayout title="Connect Content Source">
    <div class="selection-container">
        <h1>Connect Your Notion Content</h1>
        <p class="subtitle">
            Choose how you want to connect NotionGlaze to your workspace.
        </p>

        {error && <div class="error-banner">{error}</div>}

        <div class="connection-methods">
            {/* Method 1: Public Link (Simple) */}
            <div class="method-card primary-method">
                <div class="method-header">
                    <span class="badge">Easiest</span>
                    <h2>Public Link Connection</h2>
                    <p>
                        Simply paste the URL of a public Notion page containing
                        your posts.
                    </p>
                </div>

                <form method="POST" class="public-link-form">
                    <input
                        type="hidden"
                        name="connectionMode"
                        value="public_link"
                    />
                    <div class="input-group">
                        <label for="publicLinkUrl">Notion Page URL</label>
                        <input
                            type="url"
                            id="publicLinkUrl"
                            name="publicLinkUrl"
                            placeholder="https://notion.so/your-workspace/My-Blog-Page-12345..."
                            required
                        />
                        <p class="help-text">
                            Ensure the page is set to "Share to web" in Notion.
                        </p>
                    </div>
                    <button type="submit" class="btn-submit"
                        >Connect Public Link</button
                    >
                </form>
            </div>

            <div class="divider">
                <span>OR</span>
            </div>

            {/* Method 2: OAuth Database (Advanced) */}
            <div class="method-card advanced-method">
                <div class="method-header">
                    <h2>Advanced Database Connection</h2>
                    <p>
                        Connect a specific database for granular control and
                        private page support.
                    </p>
                </div>

                {
                    !hasOauthConnection ? (
                        <div class="oauth-promo">
                            <p>
                                Authenticate with Notion to select a database
                                directly.
                            </p>
                            <a
                                href="/api/v1/gateway/notion/init?mode=connect"
                                class="btn-connect-notion"
                            >
                                Connect Notion Account
                            </a>
                        </div>
                    ) : (
                        <form method="POST" class="oauth-form">
                            <input
                                type="hidden"
                                name="connectionMode"
                                value="oauth_db"
                            />

                            <div class="db-grid">
                                {databases.map((db: any) => (
                                    <label class="db-card">
                                        <input
                                            type="radio"
                                            name="databaseId"
                                            value={db.id}
                                            required
                                        />
                                        <div class="card-content">
                                            <div class="db-icon">
                                                {db.icon?.type === "emoji"
                                                    ? db.icon.emoji
                                                    : "📄"}
                                            </div>
                                            <div class="db-info">
                                                <h3>
                                                    {db.title?.[0]
                                                        ?.plain_text ||
                                                        "Untitled Database"}
                                                </h3>
                                                <div class="meta">
                                                    <span>
                                                        Edited{" "}
                                                        {new Date(
                                                            db.last_edited_time,
                                                        ).toLocaleDateString()}
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="check-circle" />
                                        </div>
                                    </label>
                                ))}
                            </div>

                            {databases.length === 0 && !error && (
                                <div class="empty-state">
                                    <p>
                                        No databases found in your connected
                                        workspace.
                                    </p>
                                    <a
                                        href="/api/v1/gateway/notion/init?mode=connect"
                                        class="btn-refresh"
                                    >
                                        Reconnect or Select Another Workspace
                                    </a>
                                </div>
                            )}

                            {databases.length > 0 && (
                                <div class="actions">
                                    <button
                                        type="submit"
                                        class="btn-submit alternative"
                                    >
                                        Confirm Selected Database
                                    </button>
                                </div>
                            )}
                        </form>
                    )
                }
            </div>
        </div>
    </div>
</DashboardLayout>

<style>
    .selection-container {
        max-width: 800px;
        margin: 4rem auto;
        padding: 0 1.5rem;
    }
    h1 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        text-align: center;
    }
    .subtitle {
        text-align: center;
        color: var(--muted-foreground);
        margin-bottom: 3rem;
    }

    .db-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .db-card {
        cursor: pointer;
        position: relative;
    }

    .db-card input {
        position: absolute;
        opacity: 0;
    }

    .card-content {
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.2s;
    }

    .db-card:hover .card-content {
        border-color: var(--primary);
        background: rgba(var(--primary-rgb), 0.02);
    }

    .db-card input:checked + .card-content {
        border-color: var(--primary);
        background: rgba(var(--primary-rgb), 0.05);
        box-shadow: 0 0 0 2px rgba(var(--primary-rgb), 0.2);
    }

    .db-icon {
        font-size: 1.5rem;
        width: 3rem;
        height: 3rem;
        background: var(--muted);
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .db-info h3 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }
    .meta {
        font-size: 0.8rem;
        color: var(--muted-foreground);
    }

    .check-circle {
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid var(--border);
        border-radius: 50%;
        margin-left: auto;
        position: relative;
    }

    .db-card input:checked + .card-content .check-circle {
        border-color: var(--primary);
        background: var(--primary);
    }

    .db-card input:checked + .card-content .check-circle::after {
        content: "";
        position: absolute;
        top: 2px;
        left: 6px;
        width: 4px;
        height: 8px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
    }
    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-cancel {
        padding: 0.75rem 1.5rem;
        color: var(--muted-foreground);
        text-decoration: none;
        font-weight: 500;
    }

    .error-banner {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .method-card {
        background: var(--background);
        border: 1px solid var(--border);
        border-radius: 1.5rem;
        padding: 2rem;
        position: relative;
    }

    .primary-method {
        border-color: var(--primary);
        background: rgba(var(--primary-rgb), 0.02);
    }

    .method-header {
        margin-bottom: 2rem;
    }

    .badge {
        display: inline-block;
        background: var(--primary);
        color: white;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 0.25rem 0.5rem;
        border-radius: 999px;
        margin-bottom: 1rem;
    }

    .method-header h2 {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .method-header p {
        color: var(--muted-foreground);
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .input-group label {
        font-weight: 600;
    }

    .input-group input {
        padding: 1rem;
        border-radius: 0.5rem;
        border: 1px solid var(--border);
        background: var(--background);
        font-size: 1rem;
    }

    .help-text {
        font-size: 0.8rem;
        color: var(--muted-foreground);
    }

    .oauth-promo {
        text-align: center;
        padding: 2rem;
        background: var(--muted);
        border-radius: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .btn-connect-notion {
        background: var(--foreground);
        color: var(--background);
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s;
    }

    .btn-connect-notion:hover {
        transform: translateY(-2px);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 3rem 0;
        color: var(--muted-foreground);
    }

    .divider::before,
    .divider::after {
        content: "";
        flex: 1;
        border-bottom: 1px solid var(--border);
    }

    .divider span {
        padding: 0 1rem;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        background: var(--muted);
        border-radius: 1rem;
    }
</style>
