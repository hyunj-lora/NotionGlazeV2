---
import DashboardLayout from "@notionglaze/ui/DashboardLayout.astro";
import { TenantService } from "@notionglaze/core";

const db = (Astro.locals as any).runtime?.env?.DB;
const tenantId = (Astro.locals as any).userId;

let tenant = null;
let error = null;
let rawDailyData = [];
let topPages = [];
let topReferrers = [];

if (db && tenantId) {
    try {
        const tenantService = new TenantService(db);
        tenant = await tenantService.getTenantByOwnerId(tenantId);

        if (tenant) {
            // Fetch 365 days of data for dynamic ranges
            const { results: dResults } = await db
                .prepare(
                    `
                    SELECT date(timestamp) as day, COUNT(*) as views
                    FROM page_views 
                    WHERE tenant_id = ? 
                    AND timestamp >= datetime('now', '-365 days')
                    GROUP BY day 
                    ORDER BY day ASC
                `,
                )
                .bind(tenant.id)
                .all();
            rawDailyData = dResults || [];

            // Top Pages (Last 30 days)
            const { results: pResults } = await db
                .prepare(
                    `
                    SELECT path, COUNT(*) as views, COUNT(DISTINCT viewer_hash) as visitors
                    FROM page_views 
                    WHERE tenant_id = ? 
                    AND timestamp >= datetime('now', '-30 days')
                    GROUP BY path 
                    ORDER BY views DESC 
                    LIMIT 10
                `,
                )
                .bind(tenant.id)
                .all();
            topPages = pResults || [];

            // Top Referrers (Last 30 days)
            const { results: rResults } = await db
                .prepare(
                    `
                    SELECT COALESCE(referrer, 'Direct/Internal') as source, COUNT(*) as views
                    FROM page_views 
                    WHERE tenant_id = ? 
                    AND timestamp >= datetime('now', '-30 days')
                    GROUP BY source 
                    ORDER BY views DESC 
                    LIMIT 10
                `,
                )
                .bind(tenant.id)
                .all();
            topReferrers = rResults || [];
        }
    } catch (e) {
        console.error("Analytics DB Error:", e);
        error = e instanceof Error ? e.message : "Database error";
    }
}
---

<DashboardLayout title="Performance Metrics" tenant={tenant}>
    <div class="space-y-8 pb-12">
        {
            error && (
                <div class="bg-destructive/10 border border-destructive/20 text-destructive p-4 rounded-xl flex items-center gap-3">
                    <div class="flex flex-col">
                        <span class="text-xs font-black uppercase tracking-widest">
                            Engine Error
                        </span>
                        <span class="text-sm font-bold">{error}</span>
                    </div>
                </div>
            )
        }

        {/* Dynamic Traffic Trend Card */}
        <section class="premium-card">
            <div
                class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10"
            >
                <div class="flex items-start gap-4">
                    <div class="p-3 bg-primary/10 rounded-xl">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            class="text-primary"
                        >
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                        </svg>
                    </div>
                    <div>
                        <h3
                            class="text-xs font-black uppercase tracking-widest text-muted-foreground/50 mb-1"
                        >
                            Audience Growth
                        </h3>
                        <h2
                            class="text-2xl font-black tracking-tight"
                            id="trend-title"
                        >
                            Traffic Trend
                        </h2>
                    </div>
                </div>

                {/* Period Selector (Rounded Rectangle System) */}
                <div
                    class="flex items-center p-1.5 bg-secondary/50 border border-border/50 rounded-xl self-start"
                >
                    {
                        ["1w", "1m", "3m", "6m", "1y"].map((p) => (
                            <button
                                class:list={[
                                    "px-4 py-1.5 text-[11px] font-black uppercase tracking-wider rounded-lg transition-all",
                                    p === "1w"
                                        ? "bg-background text-foreground shadow-sm ring-1 ring-border/10"
                                        : "text-muted-foreground hover:text-foreground",
                                ]}
                                data-period={p}
                            >
                                {p}
                            </button>
                        ))
                    }
                </div>
            </div>

            {/* SVG Area Chart Container */}
            <div class="relative h-72 w-full group" id="chart-container">
                {
                    /* 1. Clipping Layer: Strictly constrains the SVG and Guide Line */
                }
                <div
                    class="absolute inset-0 overflow-hidden rounded-xl pointer-events-none"
                    id="chart-canvas"
                >
                    <div
                        class="absolute inset-0 flex flex-col justify-between py-2 opacity-20"
                    >
                        <div
                            class="border-t border-dashed border-border w-full"
                        >
                        </div>
                        <div
                            class="border-t border-dashed border-border w-full"
                        >
                        </div>
                        <div
                            class="border-t border-dashed border-border w-full"
                        >
                        </div>
                        <div
                            class="border-t border-dashed border-border w-full"
                        >
                        </div>
                    </div>

                    <svg id="trend-chart" class="w-full h-full overflow-visible"
                    ></svg>

                    {/* Precision Guide Line (Strictly Clipped here) */}
                    <div
                        id="tooltip-line"
                        class="absolute top-0 bottom-0 w-0.5 bg-primary/20 opacity-0 transition-opacity duration-200"
                    >
                    </div>
                </div>

                {/* 2. Feedback Layer: Empty state */}
                <div
                    id="chart-empty"
                    class="hidden absolute inset-0 flex flex-col items-center justify-center text-muted-foreground pointer-events-none"
                >
                    <p class="text-sm font-bold">
                        No traffic recorded for this period
                    </p>
                </div>

                {
                    /* 3. Floating Layer: Tooltip is OUTSIDE the clipping box, so it won't be cut */
                }
                <div
                    id="chart-tooltip"
                    class="absolute pointer-events-none opacity-0 transition-opacity duration-200 z-50"
                >
                    <div
                        class="bg-foreground text-background p-3 rounded-xl shadow-2xl min-w-[120px] border border-background/20"
                    >
                        <div
                            class="text-[10px] font-black uppercase tracking-widest opacity-60 mb-1"
                            id="tooltip-date"
                        >
                        </div>
                        <div class="text-lg font-black" id="tooltip-value">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* Top Content & Sources Grid */}
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="premium-card !p-8">
                <div class="flex items-center gap-3 mb-8">
                    <div class="p-2 bg-primary/10 rounded-lg">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            class="text-primary"
                        >
                            <path
                                d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"
                            ></path>
                            <path d="M18 14h-8"></path><path d="M15 18h-5"
                            ></path><path d="M10 6h8v4h-8V6Z"></path>
                        </svg>
                    </div>
                    <h3
                        class="text-xs font-black uppercase tracking-widest text-muted-foreground/60"
                    >
                        Top Performing Pages
                    </h3>
                </div>

                <div class="space-y-5">
                    {
                        topPages.map((page: any) => (
                            <div class="flex items-center justify-between group">
                                <div class="flex flex-col min-width-0">
                                    <span class="text-sm font-bold truncate max-w-[200px] md:max-w-none group-hover:text-primary transition-colors">
                                        {page.path === "/"
                                            ? "Home Page"
                                            : page.path}
                                    </span>
                                    <span class="text-[10px] text-muted-foreground uppercase font-black tracking-tight mt-0.5">
                                        {page.visitors} unique visitors
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-black bg-primary/5 text-primary border border-primary/10 px-2.5 py-1 rounded-lg">
                                        {page.views}
                                    </span>
                                </div>
                            </div>
                        ))
                    }
                    {
                        topPages.length === 0 && (
                            <p class="text-center py-12 text-muted-foreground text-sm font-bold">
                                No data collected yet
                            </p>
                        )
                    }
                </div>
            </div>

            <div class="premium-card !p-8">
                <div class="flex items-center gap-3 mb-8">
                    <div class="p-2 bg-primary/10 rounded-lg">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            class="text-primary"
                        >
                            <path d="M20 7h-9m3 3-3-3 3-3"></path><path
                                d="m4 17 3 3 3-3"></path><path d="M4 17h9"
                            ></path><rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"></rect>
                        </svg>
                    </div>
                    <h3
                        class="text-xs font-black uppercase tracking-widest text-muted-foreground/60"
                    >
                        Top Traffic Sources
                    </h3>
                </div>

                <div class="space-y-5">
                    {
                        topReferrers.map((ref: any) => (
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-bold truncate max-w-[200px] md:max-w-none">
                                    {ref.source}
                                </span>
                                <span class="text-sm font-black text-muted-foreground">
                                    {ref.views}
                                </span>
                            </div>
                        ))
                    }
                    {
                        topReferrers.length === 0 && (
                            <p class="text-center py-12 text-muted-foreground text-sm font-bold">
                                Waiting for referral data
                            </p>
                        )
                    }
                </div>
            </div>
        </section>
    </div>
</DashboardLayout>

<script is:inline define:vars={{ rawDailyData }}>
    // Senior Implementation: Advanced Data Orchestration & SVG Generation
    let currentPeriod = "1w";
    const chart = document.getElementById("trend-chart");
    const tooltip = document.getElementById("chart-tooltip");
    const periodButtons = document.querySelectorAll("[data-period]");

    function getFilteredData(period) {
        const now = new Date();
        now.setHours(23, 59, 59, 999);
        const cutoff = new Date();
        let days = 7;

        if (period === "1w") {
            cutoff.setDate(now.getDate() - 7);
            days = 7;
        } else if (period === "1m") {
            cutoff.setMonth(now.getMonth() - 1);
            days = 30;
        } else if (period === "3m") {
            cutoff.setMonth(now.getMonth() - 3);
            days = 90;
        } else if (period === "6m") {
            cutoff.setMonth(now.getMonth() - 6);
            days = 180;
        } else if (period === "1y") {
            cutoff.setFullYear(now.getFullYear() - 1);
            days = 365;
        }

        cutoff.setHours(0, 0, 0, 0);

        // CREATE FULL TIMELINE (Senior Step: Ensure graph starts from left)
        const timeline = [];
        for (let i = 0; i <= days; i++) {
            const d = new Date(cutoff);
            d.setDate(d.getDate() + i);
            const dateStr = d.toISOString().split("T")[0];
            const existing = rawDailyData.find((rd) => rd.day === dateStr);
            timeline.push({
                day: dateStr,
                views: existing ? existing.views : 0,
            });
        }

        // Adaptive Grouping
        let displayData = timeline;
        if (period === "1y" || period === "6m") {
            const weekly = {};
            timeline.forEach((d) => {
                const date = new Date(d.day);
                const weekKey = `${date.getFullYear()}-W${Math.ceil(date.getDate() / 7)}`;
                if (!weekly[weekKey])
                    weekly[weekKey] = { day: d.day, views: 0 };
                weekly[weekKey].views += d.views;
            });
            displayData = Object.values(weekly);
        }

        return { displayData, days, cutoff, now };
    }

    function drawChart() {
        const { displayData, days, cutoff, now } =
            getFilteredData(currentPeriod);
        const container = document.getElementById("chart-container");
        const width = container.clientWidth;
        const height = container.clientHeight;
        const emptyState = document.getElementById("chart-empty");
        const title = document.getElementById("trend-title");

        // Update Title with Context
        const periodLabels = {
            "1w": "7 Days",
            "1m": "30 Days",
            "3m": "90 Days",
            "6m": "6 Months",
            "1y": "1 Year",
        };
        title.textContent = `Traffic Trend (Last ${periodLabels[currentPeriod] || currentPeriod})`;

        const maxViews = Math.max(...displayData.map((d) => d.views), 10);
        const marginX = 40;
        const chartW = width - marginX * 2;
        const chartH = height - 80;

        const startTime = cutoff.getTime();
        const endTime = now.getTime();
        const timeRange = endTime - startTime;

        const points = displayData.map((d) => {
            const timePos = new Date(d.day).getTime() - startTime;
            return {
                x: marginX + (timePos / timeRange) * chartW,
                y: height - 40 - (d.views / maxViews) * chartH,
                views: d.views,
                date: d.day,
            };
        });

        // Ensure points are sorted by X for path generation
        points.sort((a, b) => a.x - b.x);

        let d = `M ${points[0].x} ${points[0].y}`;
        if (points.length > 1) {
            for (let i = 0; i < points.length - 1; i++) {
                const p0 = points[i];
                const p1 = points[i + 1];
                const cp1x = p0.x + (p1.x - p0.x) / 2;
                d += ` C ${cp1x} ${p0.y}, ${cp1x} ${p1.y}, ${p1.x} ${p1.y}`;
            }
        } else {
            // Single point representation
            d = `M ${points[0].x - 20} ${points[0].y} L ${points[0].x + 20} ${points[0].y}`;
        }

        const areaD = `${d} L ${points[points.length - 1].x} ${height} L ${points[0].x} ${height} Z`;

        // Generate Labels (Contextual Density)
        let labelsHtml = "";
        const labelCount = currentPeriod === "1w" ? 7 : 5;
        for (let i = 0; i < labelCount; i++) {
            const t = startTime + (i / (labelCount - 1)) * timeRange;
            const date = new Date(t);
            const x = marginX + (i / (labelCount - 1)) * chartW;
            const label =
                currentPeriod === "1w"
                    ? date.toLocaleDateString(undefined, { weekday: "short" })
                    : currentPeriod === "1y"
                      ? date.toLocaleDateString(undefined, { month: "short" })
                      : date.toLocaleDateString(undefined, {
                            month: "numeric",
                            day: "numeric",
                        });

            labelsHtml += `<text x="${x}" y="${height - 10}" text-anchor="middle" class="fill-muted-foreground/40 text-[9px] font-bold uppercase tracking-tighter">${label}</text>`;
        }

        // Adaptive Point Dots (Only for high density views)
        let dotsHtml = "";
        if (currentPeriod === "1w" || currentPeriod === "1m") {
            dotsHtml = points
                .map(
                    (p) => `
                <circle cx="${p.x}" cy="${p.y}" r="4" fill="hsl(var(--background))" stroke="hsl(var(--primary))" stroke-width="2" class="opacity-0 group-hover:opacity-100 transition-opacity" />
            `,
                )
                .join("");
        }

        chart.innerHTML = `
            <defs>
                <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="hsl(var(--primary))" stop-opacity="0.2" />
                    <stop offset="100%" stop-color="hsl(var(--primary))" stop-opacity="0" />
                </linearGradient>
            </defs>
            ${labelsHtml}
            <path d="${areaD}" fill="url(#chartGradient)" class="transition-all duration-700 ease-in-out" />
            <path d="${d}" fill="none" stroke="hsl(var(--primary))" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="chart-line-path" />
            ${dotsHtml}
        `;

        // Interaction
        container.onmousemove = (e) => {
            const rect = container.getBoundingClientRect();
            const mouseX = e.clientX - rect.left;

            let closest = points[0];
            let minDist = Math.abs(mouseX - points[0].x);
            points.forEach((p) => {
                const dist = Math.abs(mouseX - p.x);
                if (dist < minDist) {
                    minDist = dist;
                    closest = p;
                }
            });

            if (minDist > 50) {
                tooltip.style.opacity = "0";
                if (document.getElementById("tooltip-line"))
                    document.getElementById("tooltip-line").style.opacity = "0";
                return;
            }

            tooltip.style.opacity = "1";
            const tooltipLine = document.getElementById("tooltip-line");
            if (tooltipLine) {
                tooltipLine.style.opacity = "1";
                tooltipLine.style.left = `${closest.x}px`;
            }

            const tooltipWidth = 140;
            let targetX = closest.x;
            if (targetX + tooltipWidth / 2 > width)
                targetX = width - tooltipWidth / 2 - 20;
            else if (targetX - tooltipWidth / 2 < 0)
                targetX = tooltipWidth / 2 + 20;

            tooltip.style.left = `${targetX}px`;
            tooltip.style.top = `${closest.y - 85}px`;
            document.getElementById("tooltip-date").textContent = new Date(
                closest.date,
            ).toLocaleDateString(undefined, {
                month: "short",
                day: "numeric",
                year: "numeric",
            });
            document.getElementById("tooltip-value").textContent =
                `${closest.views} Views`;
        };

        container.onmouseleave = () => {
            tooltip.style.opacity = "0";
            const tooltipLine = document.getElementById("tooltip-line");
            if (tooltipLine) tooltipLine.style.opacity = "0";
        };
    }

    periodButtons.forEach((btn) => {
        btn.onclick = () => {
            periodButtons.forEach((b) =>
                b.classList.remove(
                    "bg-background",
                    "text-foreground",
                    "shadow-sm",
                    "ring-1",
                    "ring-border/10",
                ),
            );
            periodButtons.forEach((b) =>
                b.classList.add("text-muted-foreground"),
            );
            btn.classList.remove("text-muted-foreground");
            btn.classList.add(
                "bg-background",
                "text-foreground",
                "shadow-sm",
                "ring-1",
                "ring-border/10",
            );
            currentPeriod = btn.dataset.period;
            drawChart();
        };
    });

    window.onresize = drawChart;
    drawChart();
</script>

<style>
    .premium-card {
        background: hsl(var(--background));
        border: 1px solid hsl(var(--border) / 0.8);
        border-radius: 2rem;
        padding: 2.5rem;
        box-shadow: 0 4px 30px -10px rgba(0, 0, 0, 0.05);
    }

    .chart-path {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: draw 1.5s ease forwards;
    }

    @keyframes draw {
        to {
            stroke-dashoffset: 0;
        }
    }

    /* Minimalist buttons override to match Squircle UI */
    button {
        -webkit-tap-highlight-color: transparent;
    }
</style>
