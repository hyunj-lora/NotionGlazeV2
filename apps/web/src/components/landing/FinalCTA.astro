---

<section class="final-cta">
    <div class="container">
        <div class="cta-box">
            <h2 class="title">Stop Compromising. Start Publishing.</h2>
            <p class="body text-center">
                I built this engine to solve the technical chaos of Notion
                blogging. No more broken images, no more slow-loading pages.
                Just your ideas, delivered instantly to the world.
            </p>
            <div class="actions">
                <a href="/login" class="btn btn-primary"
                    >Experience the Difference ($0 Forever)</a
                >
            </div>
            <div class="signature">
                <strong>— HUMANERD</strong>
                <span>The Simple Engine for Notion.</span>
            </div>
        </div>
    </div>
</section>

<style>
    .final-cta {
        padding: 10rem 0;
        background: hsl(0 0% 0%);
        color: hsl(0 0% 100%);
    }

    .cta-box {
        background: linear-gradient(
            135deg,
            hsl(var(--primary) / 0.2),
            transparent
        );
        border: 1px solid hsl(var(--primary) / 0.3);
        border-radius: 50px;
        padding: 8rem 4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        backdrop-filter: blur(20px);
    }

    .title {
        font-size: 4.5rem;
        font-weight: 900;
        margin-bottom: 2rem;
        letter-spacing: -0.04em;
    }

    .body {
        font-size: 1.5rem;
        line-height: 1.6;
        color: hsl(0 0% 100% / 0.7);
        max-width: 800px;
        margin-bottom: 4rem;
    }

    .actions {
        margin-bottom: 4rem;
    }

    .btn-primary {
        padding: 1.5rem 3rem;
        background: hsl(var(--primary));
        color: white;
        border-radius: 20px;
        font-size: 1.5rem;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 30px 60px -10px hsl(var(--primary) / 0.5);
        transition: all 0.3s;
    }

    .btn-primary:hover {
        transform: translateY(-5px);
        box-shadow: 0 40px 80px -15px hsl(var(--primary) / 0.6);
    }

    .signature {
        display: flex;
        flex-direction: column;
        align-items: center;
        opacity: 0.6;
    }

    .signature strong {
        font-size: 1.25rem;
        letter-spacing: 0.2em;
    }

    .signature span {
        font-size: 0.875rem;
    }

    @media (max-width: 768px) {
        .final-cta {
            padding: 6rem 0;
        }
        .title {
            font-size: 2.5rem;
        }
        .body {
            font-size: 1.125rem;
        }
        .cta-box {
            padding: 4rem 2rem;
        }
    }

    @media (max-width: 640px) {
        .final-cta {
            padding: 5rem 0;
        }
        .cta-box {
            padding: 3rem 1.5rem;
            border-radius: 24px;
        }
        .title {
            font-size: 2rem;
        }
        .btn-primary {
            font-size: 1.125rem;
            padding: 1.25rem 2rem;
        }
    }
</style>
