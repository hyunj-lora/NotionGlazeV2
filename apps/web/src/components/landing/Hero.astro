---

---

<section class="hero-section">
    <div class="container hero-grid">
        <div class="hero-content">
            <span class="eyebrow">The Simple Engine that Just Works</span>
            <h1 class="gradient-text">
                Tired of Broken Images?<br />Slow Notion Sites?
            </h1>
            <p class="sub-headline">
                Stop apologizing for your slow Notion blog. Turn your workspace
                into a high-performance, edge-rendered website that actually
                works. 0.1s load times. Zero broken images. No complications.
            </p>
            <div class="hero-actions">
                <a href="/login" class="btn btn-primary"
                    >Start for Free (Forever $0)</a
                >
                <span class="secondary-text"
                    >No credit card required. Up and running in 30 seconds.</span
                >
            </div>
        </div>
        <div class="hero-visual">
            <div class="visual-wrapper">
                <img
                    src="/landing/hero-split.png"
                    alt="Notion to Website Velocity"
                    class="hero-img"
                />
                <div class="glow-effect"></div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        padding: 8rem 0 6rem;
        overflow: hidden;
        position: relative;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 5rem;
        align-items: center;
    }

    .hero-content {
        position: relative;
        z-index: 10;
        background: radial-gradient(
            circle at left center,
            hsl(var(--background) / 0.8),
            transparent 70%
        );
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: hsl(var(--primary));
        margin-bottom: 1.5rem;
        background: hsl(var(--primary) / 0.1);
        padding: 0.5rem 1rem;
        border-radius: 100px;
    }

    h1 {
        font-size: 5rem;
        line-height: 1;
        font-weight: 900;
        letter-spacing: -0.04em;
        margin-bottom: 2rem;
    }

    .gradient-text {
        background: linear-gradient(
            135deg,
            hsl(var(--foreground)) 20%,
            hsl(var(--primary)) 80%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .sub-headline {
        font-size: 1.25rem;
        line-height: 1.6;
        color: hsl(var(--muted-foreground));
        max-width: 540px;
        margin-bottom: 3rem;
    }

    .hero-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.125rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        width: fit-content;
    }

    .btn-primary {
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
        box-shadow: 0 20px 40px -10px hsl(var(--primary) / 0.5);
    }

    .btn-primary:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 25px 50px -12px hsl(var(--primary) / 0.6);
    }

    .secondary-text {
        font-size: 0.875rem;
        color: hsl(var(--muted-foreground));
    }

    .hero-visual {
        position: relative;
    }

    .visual-wrapper {
        position: relative;
        border-radius: 24px;
        background: var(--surface-1);
        padding: 8px;
        border: 1px solid hsl(var(--border));
        box-shadow: 0 40px 80px -20px hsl(0 0% 0% / 0.3);
    }

    .hero-img {
        width: 100%;
        height: auto;
        border-radius: 18px;
        display: block;
    }

    .glow-effect {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(
            circle at 50% 50%,
            hsl(var(--primary) / 0.2),
            transparent 70%
        );
        filter: blur(40px);
        z-index: -1;
    }

    @media (max-width: 1024px) {
        .hero-grid {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .sub-headline {
            margin-left: auto;
            margin-right: auto;
        }
        .hero-actions {
            align-items: center;
        }
        .btn {
            width: 100%;
        }
    }

    @media (max-width: 768px) {
        .hero-section {
            padding: 5rem 0 3rem;
        }
        .sub-headline {
            font-size: 1.125rem;
            margin-bottom: 2rem;
        }
        .btn {
            padding: 1rem 2rem;
            font-size: 1rem;
        }
    }

    @media (max-width: 640px) {
        .hero-section {
            padding: 3.5rem 0 2.5rem;
        }
        h1 {
            font-size: 2.5rem;
        }
        .eyebrow {
            font-size: 0.75rem;
            padding: 0.4rem 0.8rem;
            margin-bottom: 1rem;
        }
        .sub-headline {
            font-size: 1rem;
        }
        .visual-wrapper {
            border-radius: 16px;
            padding: 6px;
        }
        .hero-img {
            border-radius: 12px;
        }
    }
</style>
