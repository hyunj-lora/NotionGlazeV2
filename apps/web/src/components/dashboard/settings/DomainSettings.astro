---
/**
 * DomainSettings.astro
 * Handles subdomain assignment and custom domain setup with real-time diagnostics.
 */
interface Props {
    tenant: any;
}

const { tenant } = Astro.props;
---

<section class="settings-section" id="sec-domains">
    <div class="section-info">
        <h3>Network & Hosting</h3>
        <p>Configure how the world accesses your content.</p>
    </div>

    <div class="settings-card space-y-8">
        <!-- 1. Subdomain Assignment -->
        <div
            class="p-6 rounded-2xl bg-secondary/20 border border-border group focus-within:border-primary transition-all"
        >
            <div class="flex items-center gap-2 mb-3">
                <label
                    class="text-[10px] font-black uppercase tracking-widest text-muted-foreground block"
                    >NotionGlaze Subdomain</label
                >
            </div>
            <div class="flex items-center gap-2">
                <div
                    class="flex-1 flex items-center bg-background border border-border rounded-xl px-4 py-2.5 focus-within:border-primary transition-all shadow-sm"
                >
                    <input
                        type="text"
                        id="subdomain"
                        class="flex-1 bg-transparent border-none p-0 text-sm font-bold focus:ring-0 text-right"
                        value={tenant?.subdomain || ""}
                        placeholder="your-site"
                    />
                    <span class="text-sm font-bold text-muted-foreground ml-1"
                        >.notionglaze.cc</span
                    >
                </div>
            </div>
            <p
                class="text-[10px] text-muted-foreground mt-3 font-medium italic"
            >
                Changes here are immediate. Your site will be available at this
                address instantly.
            </p>
        </div>

        <!-- 2. Custom Domain (Pro) -->
        <div
            class="p-6 rounded-2xl bg-primary/5 border border-primary/10 group focus-within:border-primary transition-all relative overflow-hidden"
        >
            {
                tenant?.plan !== "pro" && (
                    <div class="absolute inset-0 bg-background/60 backdrop-blur-[2px] z-10 flex items-center justify-center p-6 text-center">
                        <div class="max-w-[200px]">
                            <span class="inline-block px-2 py-0.5 rounded-full bg-primary text-white text-[9px] font-black mb-2 shadow-lg shadow-primary/20">
                                PRO FEATURE
                            </span>
                            <p class="text-xs font-bold leading-tight mb-3">
                                Upgrade to connect your own domain name.
                            </p>
                            <a
                                href="/dashboard/billing"
                                class="text-[10px] font-black uppercase text-primary hover:underline"
                            >
                                View Plans →
                            </a>
                        </div>
                    </div>
                )
            }

            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <label
                        class="text-[10px] font-black uppercase tracking-widest text-primary block"
                        >Custom Domain</label
                    >
                </div>
                <div id="domain-status-badge">
                    <!-- Dynamic Badge -->
                </div>
            </div>

            <div class="flex gap-3">
                <input
                    type="text"
                    id="custom-domain"
                    class="flex-1 bg-background border border-border rounded-xl px-4 py-2.5 text-sm font-bold focus:ring-1 focus:ring-primary focus:border-primary placeholder:text-muted-foreground/30 shadow-sm"
                    placeholder="e.g. blog.yourdomain.com"
                    value={tenant?.custom_domain || ""}
                    disabled={tenant?.plan !== "pro"}
                />
                <button
                    id="save-domain-btn"
                    class="px-5 py-2.5 rounded-xl bg-foreground text-background text-[11px] font-black uppercase tracking-wider hover:opacity-90 active:scale-95 transition-all disabled:opacity-50"
                    disabled={tenant?.plan !== "pro"}
                >
                    {tenant?.custom_domain ? "Update" : "Connect"}
                </button>
            </div>

            <!-- Verification Records Logic -->
            <div
                id="verification-records-container"
                class="mt-6 hidden animate-in fade-in slide-in-from-top-4 duration-500"
            >
                <!-- Smart Connect UI injected via JS -->
            </div>

            <div
                id="verify-action-wrap"
                class="mt-6 flex justify-center hidden"
            >
                <button
                    id="verify-domain-btn"
                    class="flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-white text-[10px] font-black uppercase tracking-widest hover:shadow-[0_8px_20px_-6px_rgba(var(--primary-rgb),0.4)] transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50"
                >
                    Verify Connection
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        // --- Helper: Copy to Clipboard ---
        const copyToClipboard = async (text: string, btn: HTMLElement) => {
            try {
                await navigator.clipboard.writeText(text);
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="text-green-500">Copied!</span>';
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                }, 2000);
            } catch (err) {
                console.error("Failed to copy", err);
            }
        };

        const domainInput = document.getElementById(
            "custom-domain",
        ) as HTMLInputElement;
        const saveDomainBtn = document.getElementById(
            "save-domain-btn",
        ) as HTMLButtonElement;
        const verifyDomainBtn = document.getElementById(
            "verify-domain-btn",
        ) as HTMLButtonElement;
        const verifyActionWrap = document.getElementById("verify-action-wrap");
        const domainStatusBadge = document.getElementById(
            "domain-status-badge",
        );
        const verificationContainer = document.getElementById(
            "verification-records-container",
        );

        const renderRecord = (record: any) => {
            const statusColors: Record<string, string> = {
                ACTIVE: "text-green-500 bg-green-500/10 border-green-500/20",
                PENDING:
                    "text-yellow-600 bg-yellow-500/10 border-yellow-500/20",
                CONFLICT: "text-red-500 bg-red-500/10 border-red-500/20",
            };

            return `
                <div class="p-4 rounded-xl border transition-all duration-300 ${record.status === "ACTIVE" ? "bg-green-500/5 border-green-500/10" : "bg-primary/5 border-primary/10"}">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <span class="px-1.5 py-0.5 rounded text-[9px] font-black tracking-widest border ${statusColors[record.status] || ""}">
                                ${record.type}
                            </span>
                            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">
                                ${record.host === "@" ? "Root / Apex" : record.host}
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="h-1.5 w-1.5 rounded-full ${record.status === "ACTIVE" ? "bg-green-500" : "bg-yellow-500 animate-pulse"}"></span>
                            <span class="text-[9px] font-bold uppercase ${record.status === "ACTIVE" ? "text-green-600" : "text-yellow-600"}">
                                ${record.status === "ACTIVE" ? "Verified" : "Pending"}
                            </span>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-[9px] text-muted-foreground font-medium uppercase">Value to set</span>
                            <button class="copy-btn text-[9px] text-primary hover:underline font-bold uppercase tracking-tight" data-copy="${record.required_value}">Copy</button>
                        </div>
                        <code class="text-[10px] bg-background border border-primary/20 rounded-md p-2.5 font-mono break-all text-primary/80 group-hover:border-primary/40 transition-colors">${record.required_value}</code>
                    </div>
                </div>
            `;
        };

        const updateDomainUI = (status: any) => {
            if (!domainStatusBadge) return;

            // 1. Update Badge
            if (status.state === "ACTIVE" || status.isHealthy) {
                const label =
                    status.state === "ACTIVE"
                        ? "Connected"
                        : "Active (Bypassing DNS)";
                domainStatusBadge.className =
                    "flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-500/10 text-green-600 text-[9px] font-bold ring-1 ring-green-500/20";
                domainStatusBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></span> ${label}`;
                verifyActionWrap?.classList.add("hidden");
            } else if (status.status === "no_domain") {
                domainStatusBadge.className =
                    "flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-500/10 text-slate-500 text-[9px] font-bold";
                domainStatusBadge.innerHTML =
                    '<span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span> Unregistered';
                verificationContainer?.classList.add("hidden");
                verifyActionWrap?.classList.add("hidden");
            } else {
                domainStatusBadge.className =
                    "flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-yellow-500/10 text-yellow-600 text-[9px] font-bold ring-1 ring-yellow-500/20";
                domainStatusBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-yellow-500 animate-pulse"></span> Setting up...`;
                verifyActionWrap?.classList.remove("hidden");
            }

            // 2. Render Records
            if (verificationContainer && status.records) {
                verificationContainer.classList.remove("hidden");
                let adviceHtml = "";
                if (status.diagnostics?.advice?.length > 0) {
                    adviceHtml = `
                            <div class="flex items-center gap-2 mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><path d="m12 14 4-4-4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
                                <span class="text-[10px] font-black text-yellow-600 uppercase tracking-tight">O2O Connectivity Applied</span>
                            </div>
                            <p class="text-[11px] text-muted-foreground leading-relaxed font-medium">
                                ${status.diagnostics.advice[0]}
                            </p>
                        </div>
                    `;
                }

                let html = `
                    <div class="mb-6">
                        ${adviceHtml}
                        <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground block mb-4">
                            DNS Setup (Add these records to your domain provider)
                        </label>
                        <div class="grid gap-4">
                            ${status.records.map(renderRecord).join("")}
                        </div>
                    </div>
                    <div class="mt-8 pt-8 border-t border-border">
                        <div class="flex items-center justify-between mb-4">
                            <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground">Troubleshooting</label>
                        </div>
                        <div class="grid gap-4">
                            <!-- Force Reset Option -->
                            <div class="p-4 rounded-xl bg-primary/5 border border-primary/10">
                                <div class="flex items-center justify-between">
                                    <div class="space-y-1">
                                        <p class="text-[11px] font-bold text-primary uppercase">Connection Deadlocked?</p>
                                        <p class="text-[10px] text-muted-foreground leading-relaxed">DNS 설정이 맞는데 계속 'Setting up'에 멈춰있다면, 시스템 연결 설정을 초기화하고 다시 호출할 수 있습니다.</p>
                                    </div>
                                    <button
                                        id="force-reset-btn"
                                        class="px-4 py-2 rounded-lg bg-background border border-border text-[9px] font-black uppercase hover:bg-slate-50 transition-colors"
                                    >
                                        Force Reset
                                    </button>
                                </div>
                            </div>

                            <!-- Advanced Tunnel Option -->
                            <details class="group p-4 rounded-xl bg-primary/5 border border-primary/10">
                                <summary class="flex items-center justify-between cursor-pointer list-none">
                                    <div class="space-y-1">
                                        <p class="text-[11px] font-bold text-primary uppercase">Manual worker Tunnel (Legacy)</p>
                                        <p class="text-[10px] text-muted-foreground">DNS 설정 방식이 불가능한 환경에서 수동으로 워커를 연결하는 구버전 방식입니다.</p>
                                    </div>
                                    <span class="text-[10px] font-black group-open:rotate-180 transition-transform">↓</span>
                                </summary>
                                <div class="mt-4 space-y-4 pt-4 border-t border-primary/10">
                                    <p class="text-[10px] text-muted-foreground leading-relaxed">자체 Cloudflare 워커를 통해 직접 터널링을 하려면 아래 스크립트를 사용하세요. (현재는 시스템 자동 O2O가 권장됩니다)</p>
                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[9px] text-muted-foreground font-black uppercase">Legacy Script</span>
                                            <button class="copy-btn text-[9px] text-primary font-bold hover:underline" data-copy="export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    url.hostname = '${status.hostname}.notionglaze.cc';
    return fetch(url.toString(), request);
  }
}">COPY SCRIPT</button>
                                        </div>
                                        <pre class="translate-y-0 text-[10px] bg-background border border-primary/10 rounded-lg p-3 font-mono text-muted-foreground overflow-x-auto">export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    url.hostname = '${status.hostname}.notionglaze.cc';
    return fetch(url.toString(), request);
  }
}</pre>
                                    </div>
                                </div>
                            </details>
                        </div>
                    </div>
                `;

                verificationContainer.innerHTML = html;
                verificationContainer
                    .querySelectorAll(".copy-btn")
                    .forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            const target = e.currentTarget as HTMLElement;
                            e.stopPropagation();
                            copyToClipboard(target.dataset.copy || "", target);
                        });
                    });
            }
        };

        const checkStatus = async () => {
            try {
                const res = await fetch("/api/v1/setup/domain-status");
                if (!res.ok) return;
                const data = await res.json();
                updateDomainUI(data);
            } catch (e) {
                console.error("Status check failed", e);
            }
        };

        // Event Listeners
        saveDomainBtn?.addEventListener("click", async () => {
            if (!domainInput) return;
            const domain = domainInput.value.trim();
            if (!domain) return;

            saveDomainBtn.disabled = true;
            saveDomainBtn.textContent = "...";

            try {
                const res = await fetch("/api/v1/setup/config", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ custom_domain: domain }),
                });

                const data = await res.json();

                if (res.ok) {
                    await checkStatus();
                } else {
                    alert(data.error || "도메인 저장에 실패했습니다.");
                }
            } catch (e) {
                alert("네트워크 오류가 발생했습니다.");
            } finally {
                saveDomainBtn.disabled = false;
                saveDomainBtn.textContent = "Update";
            }
        });

        verifyDomainBtn?.addEventListener("click", async () => {
            verifyDomainBtn.textContent = "Verifying...";
            verifyDomainBtn.disabled = true;
            await checkStatus();
            verifyDomainBtn.textContent = "Verify Connection";
            verifyDomainBtn.disabled = false;
        });

        document.addEventListener("click", async (e) => {
            const target = e.target as HTMLElement;
            if (target.id === "force-reset-btn") {
                if (
                    !confirm(
                        "연결 설정을 초기화하고 다시 연결하시겠습니까? (DNS 레코드 설정은 유지됩니다)",
                    )
                )
                    return;

                const originalText = target.textContent;
                target.textContent = "...";
                try {
                    const res = await fetch("/api/v1/setup/domain-reset", {
                        method: "POST",
                    });
                    if (res.ok) {
                        alert(
                            "리셋 완료! Cloudflare 인증 정보를 다시 불러옵니다.",
                        );
                        await checkStatus();
                    } else {
                        alert("리셋 실패. 잠시 후 다시 시도해 주세요.");
                    }
                } catch (err) {
                    alert("네트워크 오류가 발생했습니다.");
                } finally {
                    target.textContent = originalText;
                }
            }
        });

        // Initial check if domain exists
        if (domainInput?.value && domainInput?.value !== "") {
            checkStatus();
        }
    })();
</script>
