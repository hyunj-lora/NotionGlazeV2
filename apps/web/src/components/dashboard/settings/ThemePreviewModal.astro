<!-- Theme Preview Modal (Overlay) -->
<div id="theme-preview-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-header-left">
                <h2 id="modal-theme-title">Theme Preview</h2>
                <p>Experience the design across different modes.</p>
            </div>
            <div class="modal-controls">
                <div class="preview-mode-toggle">
                    <button class="mode-btn active" data-mode="light"
                        >Light</button
                    >
                    <button class="mode-btn" data-mode="dark">Dark</button>
                </div>
                <button class="modal-close">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
        <div class="modal-body" id="modal-frame">
            <!-- Dynamic Content -->
        </div>
        <div class="modal-footer">
            <button class="modal-apply-btn apply-btn-premium">Apply</button>
        </div>
    </div>
</div>

