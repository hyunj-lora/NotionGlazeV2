    // Type Definitions
    type ThemeKey = keyof typeof THEME_PREVIEWS;

    declare global {
        interface Window {
            openThemePreview: (themeKey: string) => void;
        }
    }

    let selectedTheme: string | null = null;
    const modal = document.getElementById(
        "theme-preview-modal",
    ) as HTMLElement | null;
    const modalTitle = document.getElementById(
        "modal-theme-title",
    ) as HTMLElement | null;
    const modalFrame = document.getElementById(
        "modal-frame",
    ) as HTMLElement | null;

    // Open Modal Logic (EXPOSED GLOBAL FUNCTION)
    window.openThemePreview = (themeKey: string) => {
        selectedTheme = themeKey;
        if (!selectedTheme || !modal || !modalTitle || !modalFrame) return;

        modalTitle.textContent = `Theme: ${selectedTheme.toUpperCase()}`;

        // Inject the specific theme preview or fallback
        const content = THEME_PREVIEWS[selectedTheme as ThemeKey];
        if (content) {
            modalFrame.innerHTML = content;
        } else {
            modalFrame.innerHTML = `<div style="padding:40px; text-align:center;">Preview loading...</div>`;
        }

        modal.classList.add("show");
        document.body.style.overflow = "hidden"; // Lock background scroll

        // Reset to Light Mode on open
        modalFrame.classList.remove("preview-dark-mode");
        document
            .querySelectorAll(".mode-btn")
            .forEach((b) => b.classList.remove("active"));
        document.querySelector('[data-mode="light"]')?.classList.add("active");
    };

    const closeModal = () => {
        if (modal) modal.classList.remove("show");
        document.body.style.overflow = ""; // Restore background scroll
    };

    // Events
    if (modal) {
        modal
            .querySelector(".modal-close")
            ?.addEventListener("click", closeModal);
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeModal();
        });

        // Apply Theme
        modal
            .querySelector(".modal-apply-btn")
            ?.addEventListener("click", () => {
                if (selectedTheme) {
                    // Dispatch a custom event for the parent to handle saving/updating UI
                    window.dispatchEvent(
                        new CustomEvent("theme-selected", {
                            detail: { theme: selectedTheme },
                        }),
                    );
                    closeModal();
                }
            });
    }

    // Dark/Light Toggle
    const modeBtns = document.querySelectorAll(".mode-btn");
    modeBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const targetBtn = target.closest(".mode-btn");
            if (!targetBtn) return;

            const mode = targetBtn.getAttribute("data-mode");

            // Visual Update of Buttons
            modeBtns.forEach((b) => b.classList.remove("active"));
            targetBtn.classList.add("active");

            // Logic Update: Show/Hide containers
            if (!modalFrame) return;
            const lightContainer = modalFrame.querySelector(
                ".theme-preview-light",
            ) as HTMLElement | null;
            const darkContainer = modalFrame.querySelector(
                ".theme-preview-dark",
            ) as HTMLElement | null;

            if (mode === "dark") {
                if (lightContainer) lightContainer.style.display = "none";
                if (darkContainer) darkContainer.style.display = "block";
            } else {
                if (lightContainer) lightContainer.style.display = "block";
                if (darkContainer) darkContainer.style.display = "none";
            }
        });
    });
</script>

