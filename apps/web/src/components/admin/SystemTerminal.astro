---
import type { AdminStats } from "@notionglaze/core";

interface Props {
    stats: AdminStats;
}

const { stats } = Astro.props;
---

<section class="data-section">
    <h2>Live Service Monitor</h2>
    <div id="terminal-output" class="terminal-container">
        <div class="terminal-line">
            <span class="t-time">[{new Date().toLocaleTimeString()}]</span>
            <span class="t-info">System Core Initialized...</span>
        </div>
        <div class="terminal-line">
            <span class="t-time">[{new Date().toLocaleTimeString()}]</span>
            <span class="t-info">D1 Database: Connected (notion-glaze-db)</span>
        </div>
        <div class="terminal-line">
            <span class="t-time">[{new Date().toLocaleTimeString()}]</span>
            <span class="t-info">R2 Assets: Online (notionglaze-assets)</span>
        </div>
        <div class="terminal-line">
            <span class="t-time">[{new Date().toLocaleTimeString()}]</span>
            <span class="t-info"
                >Sync Pool: Idle ({stats.totalTenants} nodes)</span
            >
        </div>
    </div>
</section>

<style>
    .data-section h2 {
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
        color: var(--muted-foreground);
    }
    /* System Tab Terminal effect */
    .terminal-container {
        background: #09090b;
        color: #4ade80;
        padding: 1.5rem;
        border-radius: 0.75rem;
        font-family: "Space Mono", monospace;
        font-size: 0.85rem;
        border: 1px solid #27272a;
        min-height: 400px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    .terminal-line {
        margin-bottom: 0.5rem;
    }
    .t-time {
        opacity: 0.5;
        margin-right: 1rem;
    }
    .t-warn {
        color: #facc15;
    }
    .t-error {
        color: #f87171;
    }
    .t-info {
        color: #4ade80;
    }
</style>
